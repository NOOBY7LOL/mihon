+private class VoiceUi(
+    private val activity: Activity,
+    private val root: ViewGroup,
+    private val source: View,
+    private val currentPage: () -> VoicePage?,
+) {
+    private val density = activity.resources.displayMetrics.density
+    private val prefs: SharedPreferences = activity.getSharedPreferences("voice_listen", Context.MODE_PRIVATE)
+    private val main = Handler(Looper.getMainLooper())
+    private val io = Executors.newSingleThreadExecutor()
+    private val player = LinePlayer(activity, prefs) { updateBar() }
+    private val cache = object : LinkedHashMap<String, List<Line>>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, List<Line>>?): Boolean = size > 40
+    }
+
+    private var lastLines: List<Line> = emptyList()
+    private var busy = false
+    private var requestId = 0
+
+    private lateinit var bar: LinearLayout
+    private lateinit var listenButton: TextView
+    private lateinit var stopButton: TextView
+
+    private fun dp(value: Int) = (value * density).toInt()
+
+    private fun pill(label: String, color: Int): TextView = TextView(activity).apply {
+        text = label
+        gravity = Gravity.CENTER
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 17f)
+        typeface = Typeface.DEFAULT_BOLD
+        setPadding(dp(18), dp(10), dp(18), dp(10))
+        background = roundedBackground(color, dp(30))
+    }
+
+    fun install(): View {
+        bar = LinearLayout(activity).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dp(6), dp(6), dp(6), dp(6))
+            background = roundedBackground(0xE6202124.toInt(), dp(40), 0x55FFFFFF, dp(1))
+            elevation = dp(8).toFloat()
+        }
+        listenButton = pill("🔊 Listen", 0xFF3949AB.toInt()).apply {
+            setOnClickListener { onListenTap() }
+            setOnLongClickListener {
+                read(openEditor = true)
+                true
+            }
+        }
+        stopButton = pill("■ Stop", 0xFFD32F2F.toInt()).apply {
+            visibility = View.GONE
+            setOnClickListener { onStopTap() }
+        }
+        val settingsButton = pill("⚙", 0xFF424242.toInt()).apply {
+            setOnClickListener { showSettings(activity, prefs) }
+        }
+        val gap = dp(3)
+        for (button in listOf(listenButton, stopButton, settingsButton)) {
+            bar.addView(
+                button,
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                    .apply { setMargins(gap, 0, gap, 0) },
+            )
+        }
+        root.addView(
+            bar,
+            FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL,
+            ).apply { setMargins(0, 0, 0, dp(52)) },
+        )
+        root.addOnAttachStateChangeListener(
+            object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) {}
+
+                override fun onViewDetachedFromWindow(v: View) {
+                    requestId++
+                    main.removeCallbacksAndMessages(null)
+                    io.shutdownNow()
+                    player.shutdown()
+                }
+            },
+        )
+        return bar
+    }
+
+    private fun updateBar() {
+        listenButton.text = if (busy) "Reading page..." else "🔊 Listen"
+        stopButton.visibility = if (busy || player.isPlaying) View.VISIBLE else View.GONE
+    }
+
+    private fun onListenTap() {
+        if (player.isPlaying) {
+            player.stop()
+        } else if (!busy) {
+            read(openEditor = false)
+        }
+    }
+
+    private fun onStopTap() {
+        if (player.isPlaying) player.stop()
+        if (busy) {
+            requestId++
+            busy = false
+            updateBar()
+        }
+    }
+
+    // ---- reading a page ------------------------------------------------------------------
+
+    private fun read(openEditor: Boolean) {
+        if (busy) return
+        val apiKey = prefs.getString("api_key", "")?.trim().orEmpty()
+        if (apiKey.isEmpty()) {
+            toast(activity, "Paste your free Google key first")
+            showSettings(activity, prefs)
+            return
+        }
+        val page = currentPage()
+        val cached = page?.let { cache[it.key] }
+        if (cached != null) {
+            deliver(cached, openEditor)
+            return
+        }
+
+        busy = true
+        player.stop()
+        val token = ++requestId
+        updateBar()
+        capture(page) { jpeg ->
+            if (token != requestId) {
+                // cancelled
+            } else if (jpeg == null) {
+                fail("Could not capture the page")
+            } else {
+                val model = prefs.getString("model", GeminiClient.DEFAULT_MODEL)?.trim().orEmpty()
+                    .ifEmpty { GeminiClient.DEFAULT_MODEL }
+                val cast = prefs.getString("cast", "").orEmpty()
+                val context = lastLines.takeLast(6).joinToString("\n") { "${it.speaker.name.lowercase()}: ${it.text}" }
+                io.execute {
+                    try {
+                        val result = try {
+                            GeminiClient.analyzePage(apiKey, model, jpeg, cast, context)
+                        } catch (e: GeminiException) {
+                            val alt = if (e.code == 404) GeminiClient.pickModel(apiKey, false) else null
+                            if (alt == null || alt == model) throw e
+                            prefs.edit().putString("model", alt).apply()
+                            main.post { toast(activity, "Reading model switched to $alt") }
+                            GeminiClient.analyzePage(apiKey, alt, jpeg, cast, context)
+                        }
+                        main.post { if (token == requestId) analyzed(result, page?.key, openEditor) }
+                    } catch (e: Exception) {
+                        val message = when (e) {
+                            is GeminiException -> e.message ?: "Gemini error"
+                            is IOException -> "Could not reach Google. Check your internet"
+                            else -> "Could not understand Gemini's answer. Try again"
+                        }
+                        main.post { if (token == requestId) fail(message) }
+                    }
+                }
+            }
+        }
+    }
+
+    private fun analyzed(result: List<Pair<String, String>>, key: String?, openEditor: Boolean) {
+        busy = false
+        val lines = result.map { Line(it.first, speakerFromWord(it.second)) }
+        if (lines.isNotEmpty()) {
+            lastLines = lines
+            if (key != null) cache[key] = lines
+        }
+        updateBar()
+        deliver(lines, openEditor)
+    }
+
+    private fun fail(message: String) {
+        busy = false
+        updateBar()
+        toast(activity, message)
+    }
+
+    private fun deliver(lines: List<Line>, openEditor: Boolean) {
+        if (activity.isFinishing || activity.isDestroyed) return
+        if (lines.isEmpty()) {
+            toast(activity, "No text found on this page")
+        } else if (openEditor) {
+            LinesDialog(activity, prefs, player, lines).show()
+        } else {
+            val unsure = lines.count { it.speaker == Speaker.UNSURE }
+            if (!prefs.getBoolean("tip_shown", false)) {
+                prefs.edit().putBoolean("tip_shown", true).apply()
+                toast(activity, "Tip: hold Listen to fix who speaks a line")
+            } else if (unsure > 0) {
+                toast(activity, "$unsure line(s) unsure. Hold Listen to fix them")
+            }
+            player.play(lines)
+        }
+    }
+
+    /** The page image as a JPEG: the original file when possible, otherwise a screenshot. */
+    private fun capture(page: VoicePage?, onResult: (ByteArray?) -> Unit) {
+        val provider = page?.stream
+        io.execute {
+            val original = if (provider != null) {
+                try {
+                    decodeOriginal(provider)
+                } catch (e: Throwable) {
+                    null
+                }
+            } else {
+                null
+            }
+            main.post {
+                if (original != null) onResult(original) else screenshot(onResult)
+            }
+        }
+    }
+
+    private fun screenshot(onResult: (ByteArray?) -> Unit) {
+        if (source.width <= 0 || source.height <= 0) {
+            onResult(null)
+            return
+        }
+        val location = IntArray(2)
+        source.getLocationInWindow(location)
+        val area = Rect(location[0], location[1], location[0] + source.width, location[1] + source.height)
+        val previous = bar.visibility
+        bar.visibility = View.INVISIBLE
+        main.postDelayed(
+            {
+                val bitmap = try {
+                    Bitmap.createBitmap(area.width(), area.height(), Bitmap.Config.ARGB_8888)
+                } catch (e: Throwable) {
+                    null
+                }
+                if (bitmap == null) {
+                    bar.visibility = previous
+                    onResult(null)
+                } else {
+                    try {
+                        PixelCopy.request(
+                            activity.window,
+                            area,
+                            bitmap,
+                            { result ->
+                                bar.visibility = previous
+                                if (result == PixelCopy.SUCCESS) {
+                                    val out = ByteArrayOutputStream()
+                                    bitmap.compress(Bitmap.CompressFormat.JPEG, 90, out)
+                                    onResult(out.toByteArray())
+                                } else {
+                                    onResult(null)
+                                }
+                            },
+                            main,
+                        )
+                    } catch (e: Throwable) {
+                        bar.visibility = previous
+                        onResult(null)
+                    }
+                }
+            },
+            120,
+        )
+    }
+}
+
+/** Speaks lines one after another with Gemini voices (online) or the phone's own voice. */
+private class LinePlayer(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val onChange: () -> Unit,
+) {
+    private val main = Handler(Looper.getMainLooper())
+    private val net = Executors.newFixedThreadPool(3)
+
+    private var tts: TextToSpeech? = null
+    private var ttsReady = false
+    private var ttsFailed = false
+    private var girlVoice: Voice? = null
+    private var boyVoice: Voice? = null
+    private var defaultVoice: Voice? = null
+
+    private var queue: List<Line> = emptyList()
+    private var index = 0
+    @Volatile
+    private var generation = 0
+    private var track: AudioTrack? = null
+    private var utteranceId = ""
+    private var warned = false
+
+    @Volatile
+    private var lastError: String? = null
+
+    @Volatile
+    var isPlaying = false
+        private set
+
+    init {
+        tts = TextToSpeech(activity.applicationContext) { status ->
+            if (status == TextToSpeech.SUCCESS) {
+                val engine = tts
+                engine?.setLanguage(Locale.US)
+                pickPhoneVoices(engine)
+                engine?.setOnUtteranceProgressListener(
+                    object : UtteranceProgressListener() {
+                        override fun onStart(id: String?) {}
+
+                        override fun onDone(id: String?) {
+                            main.post {
+                                if (id == utteranceId && isPlaying) {
+                                    index++
+                                    step(generation)
+                                }
+                            }
+                        }
+
+                        @Deprecated("Deprecated in Java")
+                        override fun onError(id: String?) {
+                            main.post { if (id == utteranceId) stop() }
+                        }
+                    },
+                )
+                ttsReady = true
+            } else {
+                ttsFailed = true
+            }
+        }
+    }
+
+    private fun pickPhoneVoices(engine: TextToSpeech?) {
+        try {
+            defaultVoice = engine?.defaultVoice
+            val english = (engine?.voices ?: emptySet()).filter {
+                it.locale.language == "en" && !it.isNetworkConnectionRequired
+            }
+            girlVoice = english.firstOrNull { it.name.contains("female", ignoreCase = true) }
+            boyVoice = english.firstOrNull {
+                it.name.contains("male", ignoreCase = true) && !it.name.contains("female", ignoreCase = true)
+            }
+        } catch (e: Throwable) {
+            // Fall back to pitch changes only.
+        }
+    }
+
+    private fun voiceName(speaker: Speaker): String? {
+        if (!prefs.getBoolean("gemini_voices", true)) return null
+        if (prefs.getString("api_key", "").isNullOrBlank()) return null
+        val key = when (speaker) {
+            Speaker.GIRL -> "voice_girl"
+            Speaker.BOY -> "voice_boy"
+            Speaker.CUSTOM -> "voice_custom"
+            else -> "voice_narrator"
+        }
+        val name = prefs.getString(key, DEFAULT_VOICES[key])?.trim()
+        return if (name.isNullOrEmpty()) null else name
+    }
+
+    private fun geminiOn(): Boolean =
+        prefs.getBoolean("gemini_voices", true) && !prefs.getString("api_key", "").isNullOrBlank()
+
+    fun play(lines: List<Line>) {
+        stopQuiet()
+        generation++
+        queue = lines
+        index = 0
+        isPlaying = true
+        warned = false
+        lastError = null
+        onChange()
+        if (geminiOn() && lines.any { it.speaker != Speaker.SKIP }) startGemini(generation) else step(generation)
+    }
+
+    /** Phone voice, line by line. Also the fallback when Gemini is unavailable. */
+    private fun step(gen: Int) {
+        if (gen != generation || !isPlaying) return
+        while (index < queue.size && queue[index].speaker == Speaker.SKIP) index++
+        if (index >= queue.size) {
+            isPlaying = false
+            onChange()
+            return
+        }
+        speakOnPhone(queue[index], gen)
+    }
+
+    private fun voiceFor(speaker: Speaker): String =
+        voiceName(speaker) ?: voiceName(Speaker.NARRATOR) ?: DEFAULT_VOICES.getValue("voice_narrator")
+
+    private fun labelFor(speaker: Speaker): String = when (speaker) {
+        Speaker.GIRL -> "Girl"
+        Speaker.BOY -> "Boy"
+        Speaker.CUSTOM -> "Custom"
+        else -> "Narrator"
+    }
+
+    /** One request for the whole page: at most two voices (Gemini's limit), the most used ones. */
+    private fun buildPlan(lines: List<Line>): Pair<List<Pair<String, String>>, String> {
+        val active = lines.filter { it.speaker != Speaker.SKIP }
+        val counts = LinkedHashMap<String, Int>()
+        val labels = HashMap<String, String>()
+        for (line in active) {
+            val voice = voiceFor(line.speaker)
+            counts[voice] = (counts[voice] ?: 0) + 1
+            if (!labels.containsKey(voice)) labels[voice] = labelFor(line.speaker)
+        }
+        val keep = counts.entries.sortedByDescending { it.value }.take(2).map { it.key }
+        val voices = keep.map { (labels[it] ?: "Narrator") to it }
+        val text = StringBuilder()
+        if (keep.size >= 2) {
+            text.append("Read this manga dialogue naturally, pausing briefly between lines:\n")
+            for (line in active) {
+                var voice = voiceFor(line.speaker)
+                if (voice !in keep) voice = keep.first()
+                text.append(labels[voice]).append(": ").append(line.text).append("\n")
+            }
+        } else {
+            text.append("Read this manga dialogue naturally, pausing briefly between lines:\n")
+            for (line in active) text.append(line.text).append("\n")
+        }
+        return voices to text.toString().trim()
+    }
+
+    private fun startGemini(gen: Int) {
+        val (voices, text) = buildPlan(queue)
+        val apiKey = prefs.getString("api_key", "")?.trim().orEmpty()
+        val model = prefs.getString("tts_model", GeminiClient.DEFAULT_TTS_MODEL)?.trim().orEmpty()
+            .ifEmpty { GeminiClient.DEFAULT_TTS_MODEL }
+
+        net.execute {
+            fun alive() = gen == generation && isPlaying
+            val pop = GapPop()
+            val preroll = ByteArrayOutputStream()
+            var audio: AudioTrack? = null
+            var frames = 0L
+            var received = 0
+            var held: ByteArray? = null
+
+            fun write(bytes: ByteArray): Boolean {
+                val t = audio ?: return false
+                var offset = 0
+                while (offset < bytes.size) {
+                    if (!alive()) return false
+                    val n = try {
+                        t.write(bytes, offset, bytes.size - offset)
+                    } catch (e: Throwable) {
+                        -1
+                    }
+                    if (n <= 0) return false
+                    offset += n
+                }
+                frames += bytes.size / 2
+                return true
+            }
+
+            fun startTrack(): Boolean {
+                if (audio != null) return true
+                val min = AudioTrack.getMinBufferSize(
+                    GeminiClient.SAMPLE_RATE,
+                    AudioFormat.CHANNEL_OUT_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT,
+                )
+                val created = AudioTrack.Builder()
+                    .setAudioAttributes(
+                        AudioAttributes.Builder()
+                            .setUsage(AudioAttributes.USAGE_MEDIA)
+                            .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                            .build(),
+                    )
+                    .setAudioFormat(
+                        AudioFormat.Builder()
+                            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                            .setSampleRate(GeminiClient.SAMPLE_RATE)
+                            .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                            .build(),
+                    )
+                    .setBufferSizeInBytes(maxOf(min * 4, 96000))
+                    .setTransferMode(AudioTrack.MODE_STREAM)
+                    .build()
+                audio = created
+                track = created
+                created.play()
+                return true
+            }
+
+            // Hold back the newest piece so the very end can be faded out (no click).
+            fun push(raw: ByteArray): Boolean {
+                val processed = pop.process(raw)
+                if (processed.isEmpty()) return true
+                val previous = held
+                held = processed
+                if (audio == null) {
+                    if (previous != null) preroll.write(previous)
+                    if (preroll.size() < 40000) return true
+                    startTrack()
+                    val ready = preroll.toByteArray()
+                    preroll.reset()
+                    return write(ready)
+                }
+                return previous == null || write(previous)
+            }
+
+            fun sink(raw: ByteArray): Boolean {
+                if (!alive()) return false
+                received += raw.size
+                return push(raw)
+            }
+
+            fun finish() {
+                val rest = pop.flush()
+                if (rest.isNotEmpty()) push(rest)
+                val last = held
+                held = null
+                if (last != null) preroll.write(fadeOut(last))
+                if (preroll.size() > 0) {
+                    startTrack()
+                    write(preroll.toByteArray())
+                }
+                val t = audio
+                if (t != null && alive()) {
+                    try {
+                        t.stop()
+                    } catch (e: Throwable) {
+                        // ignore
+                    }
+                    var waited = 0
+                    while (alive() && waited < 90_000) {
+                        val head = try {
+                            t.playbackHeadPosition.toLong() and 0xFFFFFFFFL
+                        } catch (e: Throwable) {
+                            frames
+                        }
+                        if (head >= frames) break
+                        Thread.sleep(40)
+                        waited += 40
+                    }
+                }
+                main.post {
+                    if (alive()) {
+                        releaseTrack()
+                        isPlaying = false
+                        onChange()
+                    }
+                }
+            }
+
+            fun giveUp(message: String?) {
+                main.post {
+                    if (alive()) {
+                        releaseTrack()
+                        if (!warned) {
+                            warned = true
+                            toast(activity, "Gemini voice unavailable (${message ?: "unknown"}). Using phone voice")
+                        }
+                        index = 0
+                        step(gen)
+                    }
+                }
+            }
+
+            try {
+                try {
+                    GeminiClient.synthesizeStream(apiKey, model, voices, text) { sink(it) }
+                } catch (e: GeminiException) {
+                    val hard = e.code == 429 || e.code == 401 || e.code == 403
+                    if (received == 0 && e.code == 404) {
+                        val alt = GeminiClient.pickModel(apiKey, true) ?: throw e
+                        if (alt == model) throw e
+                        prefs.edit().putString("tts_model", alt).apply()
+                        main.post { toast(activity, "Voice model switched to $alt") }
+                        GeminiClient.synthesizeStream(apiKey, alt, voices, text) { sink(it) }
+                    } else if (received == 0 && !hard) {
+                        sink(GeminiClient.synthesize(apiKey, model, voices, text))
+                    } else {
+                        throw e
+                    }
+                }
+                if (received == 0) throw GeminiException("Gemini sent no audio")
+                finish()
+            } catch (e: Exception) {
+                if (received == 0) {
+                    giveUp(e.message)
+                } else {
+                    finish()
+                }
+            }
+        }
+    }
+
+    /** A short fade so the clip never ends with a click or beep. */
+    private fun fadeOut(pcm: ByteArray): ByteArray {
+        val samples = pcm.size / 2
+        val n = minOf(samples, GeminiClient.SAMPLE_RATE * 40 / 1000)
+        for (k in 0 until n) {
+            val i = (samples - n + k) * 2
+            val v = (pcm[i].toInt() and 0xFF) or (pcm[i + 1].toInt() shl 8)
+            val scaled = (v * (1f - (k + 1f) / n)).toInt()
+            pcm[i] = (scaled and 0xFF).toByte()
+            pcm[i + 1] = ((scaled shr 8) and 0xFF).toByte()
+        }
+        return pcm
+    }
+
+    private fun speakOnPhone(line: Line, gen: Int) {
+        if (gen != generation || !isPlaying) return
+        if (ttsFailed) {
+            toast(activity, "Text-to-speech is not available on this phone")
+            stop()
+            return
+        }
+        val engine = tts
+        if (!ttsReady || engine == null) {
+            main.postDelayed({ speakOnPhone(line, gen) }, 300)
+            return
+        }
+        val speaker = line.speaker
+        val voice = when (speaker) {
+            Speaker.GIRL -> girlVoice
+            Speaker.BOY -> boyVoice
+            else -> null
+        }
+        if (voice != null) {
+            engine.setVoice(voice)
+            engine.setPitch(1.0f)
+        } else {
+            defaultVoice?.let { engine.setVoice(it) }
+            engine.setPitch(speaker.pitch)
+        }
+        engine.setSpeechRate(speaker.rate * prefs.getFloat("speed", 1.0f))
+        utteranceId = "g$gen-$index"
+        engine.speak(line.text, TextToSpeech.QUEUE_FLUSH, null, utteranceId)
+    }
+
+    private fun releaseTrack() {
+        try {
+            track?.stop()
+        } catch (e: Throwable) {
+            // already stopped
+        }
+        try {
+            track?.release()
+        } catch (e: Throwable) {
+            // already released
+        }
+        track = null
+    }
+
+    private fun stopQuiet() {
+        isPlaying = false
+        generation++
+        try {
+            tts?.stop()
+        } catch (e: Throwable) {
+            // ignore
+        }
+        releaseTrack()
+    }
+
+    fun stop() {
+        stopQuiet()
+        onChange()
+    }
+
+    fun shutdown() {
+        stopQuiet()
+        tts?.shutdown()
+        tts = null
+        net.shutdownNow()
+    }
+}
+
+/** A soft, short "bubble pop" (24 kHz, 16-bit mono), played in the pause between bubbles. */
+private val POP: ByteArray by lazy {
+    val rate = GeminiClient.SAMPLE_RATE
+    val n = rate * 110 / 1000
+    val out = ByteArray(n * 2)
+    var phase = 0.0
+    for (i in 0 until n) {
+        val t = i / rate.toDouble()
+        phase += 2 * PI * (260.0 + 700.0 * exp(-t / 0.018)) / rate
+        val attack = minOf(1.0, i / 48.0)
+        val v = (sin(phase) * exp(-t / 0.028) * attack * 0.20 * 32767).toInt()
+        out[i * 2] = (v and 0xFF).toByte()
+        out[i * 2 + 1] = ((v shr 8) and 0xFF).toByte()
+    }
+    out
+}
+
+/** Finds the pauses between bubbles in the speech and puts the soft pop into them. */
+private class GapPop {
+    private val window = GeminiClient.SAMPLE_RATE / 50 // 20 ms
+    private val leftover = ByteArrayOutputStream()
+    private var silent = 0
+    private var heard = false
+    private var popped = false
+
+    fun process(raw: ByteArray): ByteArray {
+        leftover.write(raw)
+        val data = leftover.toByteArray()
+        leftover.reset()
+        val size = window * 2
+        val out = ByteArrayOutputStream(data.size + POP.size)
+        var offset = 0
+        while (offset + size <= data.size) {
+            var peak = 0
+            var i = offset
+            while (i < offset + size) {
+                val v = (data[i].toInt() and 0xFF) or (data[i + 1].toInt() shl 8)
+                if (abs(v) > peak) peak = abs(v)
+                i += 2
+            }
+            out.write(data, offset, size)
+            if (peak < 500) {
+                silent++
+                if (heard && !popped && silent >= 14) {
+                    out.write(POP)
+                    popped = true
+                }
+            } else {
+                silent = 0
+                heard = true
+                popped = false
+            }
+            offset += size
+        }
+        if (offset < data.size) leftover.write(data, offset, data.size - offset)
+        return out.toByteArray()
+    }
+
+    fun flush(): ByteArray {
+        val rest = leftover.toByteArray()
+        leftover.reset()
+        return rest
+    }
+}
+
+/** Lines found on the page, so the speaker of any line can be fixed. Opened by holding Listen. */
+private class LinesDialog(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val player: LinePlayer,
+    private val lines: List<Line>,
+) {
+    private val list = LinearLayout(activity).apply { orientation = LinearLayout.VERTICAL }
+    private val density = activity.resources.displayMetrics.density
+
+    private fun dp(value: Int) = (value * density).toInt()
+
+    private fun label(message: String, sp: Float, bold: Boolean = false) = TextView(activity).apply {
+        text = message
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        if (bold) typeface = Typeface.DEFAULT_BOLD
+    }
+
+    private fun button(message: String, color: Int, onClick: (Button) -> Unit) = Button(activity).apply {
+        text = message
+        isAllCaps = false
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+        typeface = Typeface.DEFAULT_BOLD
+        minHeight = dp(44)
+        background = roundedBackground(color, dp(10))
+        setOnClickListener { onClick(this) }
+    }
+
+    private fun render() {
+        list.removeAllViews()
+        for (line in lines) {
+            val row = LinearLayout(activity).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, dp(6), 0, dp(6))
+            }
+            val who = button(line.speaker.emoji + " " + line.speaker.label, line.speaker.color) { b ->
+                line.speaker = line.speaker.next()
+                b.text = line.speaker.emoji + " " + line.speaker.label
+                b.background = roundedBackground(line.speaker.color, dp(10))
+            }
+            val text = label(line.text, 18f).apply {
+                maxLines = 4
+                ellipsize = TextUtils.TruncateAt.END
+                setPadding(dp(12), 0, 0, 0)
+                setOnClickListener { player.play(listOf(Line(line.text, line.speaker))) }
+            }
+            row.addView(who, LinearLayout.LayoutParams(dp(130), ViewGroup.LayoutParams.WRAP_CONTENT))
+            row.addView(text, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            list.addView(row)
+        }
+    }
+
+    fun show() {
+        val root = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(18), dp(16), dp(18), dp(12))
+        }
+        val dialog = AlertDialog.Builder(activity)
+            .setView(root)
+            .setOnDismissListener { player.stop() }
+            .create()
+        dialog.window?.setBackgroundDrawable(roundedBackground(0xFF202124.toInt(), dp(16)))
+
+        val hint = label(
+            "Tap a name to change who speaks. Tap a line to hear just that one. A ? means the AI was not sure.",
+            15f,
+        ).apply { setTextColor(0xFFCCCCCC.toInt()) }
+        val scroll = ScrollView(activity).apply { addView(list) }
+
+        val buttons = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+        val play = button("Play all", 0xFF3949AB.toInt()) { player.play(lines.map { Line(it.text, it.speaker) }) }
+        val stop = button("Stop", 0xFFD32F2F.toInt()) { player.stop() }
+        val close = button("Close", 0xFF424242.toInt()) { dialog.dismiss() }
+        val gap = dp(4)
+        for (b in listOf(play, stop, close)) {
+            buttons.addView(
+                b,
+                LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply {
+                    setMargins(gap, 0, gap, 0)
+                },
+            )
+        }
+
+        root.addView(label("Lines on this page", 22f, bold = true))
+        root.addView(hint)
+        root.addView(
+            scroll,
+            LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                (activity.resources.displayMetrics.heightPixels * 0.5f).toInt(),
+            ).apply { setMargins(0, dp(8), 0, dp(8)) },
+        )
+        root.addView(buttons)
+
+        render()
+        dialog.show()
+    }
+}
+
+/** Key, models, voice names, cast and speed. Everything is stored only on this phone. */
+private fun showSettings(activity: Activity, prefs: SharedPreferences) {
+    val density = activity.resources.displayMetrics.density
+    fun dp(value: Int) = (value * density).toInt()
+
+    val root = LinearLayout(activity).apply {
+        orientation = LinearLayout.VERTICAL
+        setPadding(dp(18), dp(16), dp(18), dp(12))
+    }
+    val scroll = ScrollView(activity).apply { addView(root) }
+    val dialog = AlertDialog.Builder(activity).setView(scroll).create()
+    dialog.window?.setBackgroundDrawable(roundedBackground(0xFF202124.toInt(), dp(16)))
+
+    fun title(message: String) = TextView(activity).apply {
+        text = message
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+        typeface = Typeface.DEFAULT_BOLD
+    }
+
+    fun caption(message: String) = TextView(activity).apply {
+        text = message
+        setTextColor(0xFFCCCCCC.toInt())
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        setPadding(0, dp(12), 0, 0)
+    }
+
+    fun field(hint: String, value: String, secret: Boolean = false, multiline: Boolean = false) =
+        EditText(activity).apply {
+            setText(value)
+            this.hint = hint
+            setTextColor(Color.WHITE)
+            setHintTextColor(0xFF888888.toInt())
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+            inputType = when {
+                secret -> InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                multiline -> InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE
+                else -> InputType.TYPE_CLASS_TEXT
+            }
+            if (multiline) minLines = 3
+        }
+
+    val keyField = field("Paste your Google key", prefs.getString("api_key", "").orEmpty(), secret = true)
+    val modelField = field(GeminiClient.DEFAULT_MODEL, prefs.getString("model", GeminiClient.DEFAULT_MODEL).orEmpty())
+    val castField = field(
+        "Example: Kagari is the long-haired girl. Nana-kun is the short-haired boy.",
+        prefs.getString("cast", "").orEmpty(),
+        multiline = true,
+    )
+    val geminiVoices = CheckBox(activity).apply {
+        text = "Use Gemini voices (natural, online)"
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+        isChecked = prefs.getBoolean("gemini_voices", true)
+    }
+    val ttsField = field(
+        GeminiClient.DEFAULT_TTS_MODEL,
+        prefs.getString("tts_model", GeminiClient.DEFAULT_TTS_MODEL).orEmpty(),
+    )
+    val voiceFields = linkedMapOf(
+        "voice_girl" to "Girl voice name",
+        "voice_boy" to "Boy voice name",
+        "voice_narrator" to "Narrator voice name (also used for ? lines)",
+        "voice_custom" to "Custom voice name (leave empty to use the phone voice)",
+    ).mapValues { (key, hint) ->
+        field(hint, prefs.getString(key, DEFAULT_VOICES[key]).orEmpty())
+    }
+    var speed = prefs.getFloat("speed", 1.0f)
+    fun speedLabel() = "Phone voice speed: " + (SPEED_LABELS.firstOrNull { it.second == speed }?.first ?: "Normal")
+    val speedButton = Button(activity).apply {
+        text = speedLabel()
+        isAllCaps = false
+        setTextColor(Color.WHITE)
+        background = roundedBackground(0xFF3949AB.toInt(), dp(10))
+        setOnClickListener {
+            val i = SPEED_LABELS.indexOfFirst { it.second == speed }
+            speed = SPEED_LABELS[(i + 1) % SPEED_LABELS.size].second
+            text = speedLabel()
+        }
+    }
+
+    root.addView(title("Voice settings"))
+    root.addView(caption("Google key (free, from aistudio.google.com). It stays only on this phone."))
+    root.addView(keyField)
+    root.addView(caption("Reading model (finds the text and who speaks)"))
+    root.addView(modelField)
+    root.addView(caption("Characters, so the AI can tell them apart (optional)"))
+    root.addView(castField)
+    root.addView(geminiVoices)
+    root.addView(caption("Voice model"))
+    root.addView(ttsField)
+    for ((_, view) in voiceFields) root.addView(view)
+    root.addView(
+        speedButton,
+        LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            .apply { setMargins(0, dp(12), 0, 0) },
+    )
+
+    val buttons = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+    val save = Button(activity).apply {
+        text = "Save"
+        isAllCaps = false
+        setTextColor(Color.WHITE)
+        background = roundedBackground(0xFF3949AB.toInt(), dp(10))
+        setOnClickListener {
+            val edit = prefs.edit()
+                .putString("api_key", keyField.text.toString().trim())
+                .putString("model", modelField.text.toString().trim())
+                .putString("cast", castField.text.toString().trim())
+                .putBoolean("gemini_voices", geminiVoices.isChecked)
+                .putString("tts_model", ttsField.text.toString().trim())
+                .putFloat("speed", speed)
+            for ((key, view) in voiceFields) edit.putString(key, view.text.toString().trim())
+            edit.apply()
+            dialog.dismiss()
+            toast(activity, "Saved")
+        }
+    }
+    val cancel = Button(activity).apply {
+        text = "Cancel"
+        isAllCaps = false
+        setTextColor(Color.WHITE)
+        background = roundedBackground(0xFF424242.toInt(), dp(10))
+        setOnClickListener { dialog.dismiss() }
+    }
+    val gap = dp(4)
+    for (b in listOf(save, cancel)) {
+        buttons.addView(
+            b,
+            LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply { setMargins(gap, 0, gap, 0) },
+        )
+    }
+    root.addView(
+        buttons,
+        LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            .apply { setMargins(0, dp(16), 0, 0) },
+    )
+    dialog.show()
+}
