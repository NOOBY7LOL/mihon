+/** A soft, short "bubble pop" (24 kHz, 16-bit mono), played in the pause between bubbles. */
+private val POP: ByteArray by lazy {
+    val rate = GeminiClient.SAMPLE_RATE
+    val n = rate * 110 / 1000
+    val out = ByteArray(n * 2)
+    var phase = 0.0
+    for (i in 0 until n) {
+        val t = i / rate.toDouble()
+        phase += 2 * PI * (260.0 + 700.0 * exp(-t / 0.018)) / rate
+        val attack = minOf(1.0, i / 48.0)
+        val v = (sin(phase) * exp(-t / 0.028) * attack * 0.20 * 32767).toInt()
+        out[i * 2] = (v and 0xFF).toByte()
+        out[i * 2 + 1] = ((v shr 8) and 0xFF).toByte()
+    }
+    out
+}
+
+/** Finds the pauses between bubbles in the speech and puts the soft pop into them. */
+private class GapPop {
+    private val window = GeminiClient.SAMPLE_RATE / 50 // 20 ms
+    private val leftover = ByteArrayOutputStream()
+    private var silent = 0
+    private var heard = false
+    private var popped = false
+
+    fun process(raw: ByteArray): ByteArray {
+        leftover.write(raw)
+        val data = leftover.toByteArray()
+        leftover.reset()
+        val size = window * 2
+        val out = ByteArrayOutputStream(data.size + POP.size)
+        var offset = 0
+        while (offset + size <= data.size) {
+            var peak = 0
+            var i = offset
+            while (i < offset + size) {
+                val v = (data[i].toInt() and 0xFF) or (data[i + 1].toInt() shl 8)
+                if (abs(v) > peak) peak = abs(v)
+                i += 2
+            }
+            out.write(data, offset, size)
+            if (peak < 500) {
+                silent++
+                if (heard && !popped && silent >= 14) {
+                    out.write(POP)
+                    popped = true
+                }
+            } else {
+                silent = 0
+                heard = true
+                popped = false
+            }
+            offset += size
+        }
+        if (offset < data.size) leftover.write(data, offset, data.size - offset)
+        return out.toByteArray()
+    }
+
+    fun flush(): ByteArray {
+        val rest = leftover.toByteArray()
+        leftover.reset()
+        return rest
+    }
+}
