+    }
+    val dialog = AlertDialog.Builder(activity).setView(root).create()
+    dialog.window?.setBackgroundDrawable(roundedBackground(0xFF202124.toInt(), dp(16)))
+
+    fun refresh() {
+        val text = VoiceLog.text()
