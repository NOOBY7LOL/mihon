+/** Speaks lines one after another with Gemini voices (online) or the phone's own voice. */
+private class LinePlayer(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val onChange: () -> Unit,
+) {
+    private val main = Handler(Looper.getMainLooper())
+    private val net = Executors.newFixedThreadPool(3)
+
+    private var tts: TextToSpeech? = null
+    private var ttsReady = false
+    private var ttsFailed = false
+    private var girlVoice: Voice? = null
+    private var boyVoice: Voice? = null
+    private var defaultVoice: Voice? = null
+    private var phoneVoices: List<Voice> = emptyList()
+
+    private var queue: List<Line> = emptyList()
+    private var index = 0
+    @Volatile
+    private var generation = 0
+    private var track: AudioTrack? = null
+    private var utteranceId = ""
+    private var warned = false
+
+    @Volatile
+    private var lastError: String? = null
+
+    @Volatile
+    var isPlaying = false
+        private set
+
+    init {
+        tts = TextToSpeech(activity.applicationContext) { status ->
+            if (status == TextToSpeech.SUCCESS) {
+                val engine = tts
+                engine?.setLanguage(Locale.US)
+                pickPhoneVoices(engine)
+                engine?.setOnUtteranceProgressListener(
+                    object : UtteranceProgressListener() {
+                        override fun onStart(id: String?) {}
+
+                        override fun onDone(id: String?) {
+                            main.post {
+                                if (id == utteranceId && isPlaying) {
+                                    val g = generation
+                                    index++
+                                    playPop()
+                                    main.postDelayed({ step(g) }, 150)
+                                }
+                            }
+                        }
+
+                        @Deprecated("Deprecated in Java")
+                        override fun onError(id: String?) {
+                            main.post { if (id == utteranceId) stop() }
+                        }
+                    },
+                )
+                ttsReady = true
+            } else {
+                ttsFailed = true
+            }
+        }
+    }
+
+    private fun pickPhoneVoices(engine: TextToSpeech?) {
+        try {
+            defaultVoice = engine?.defaultVoice
+            val english = (engine?.voices ?: emptySet()).filter {
+                it.locale.language == "en" && !it.isNetworkConnectionRequired
+            }
+            phoneVoices = english.sortedBy { it.name }
+            girlVoice = english.firstOrNull { it.name.contains("female", ignoreCase = true) }
+            boyVoice = english.firstOrNull {
+                it.name.contains("male", ignoreCase = true) && !it.name.contains("female", ignoreCase = true)
+            }
+        } catch (e: Throwable) {
+            // Fall back to pitch changes only.
+        }
+    }
+
+    private fun voiceName(speaker: Speaker): String? {
+        if (!prefs.getBoolean("gemini_voice_on", false)) return null
+        if (prefs.getString("api_key", "").isNullOrBlank()) return null
+        val key = when (speaker) {
+            Speaker.GIRL -> "voice_girl"
+            Speaker.BOY -> "voice_boy"
+            Speaker.CUSTOM -> "voice_custom"
+            else -> "voice_narrator"
+        }
+        val name = prefs.getString(key, DEFAULT_VOICES[key])?.trim()
+        return if (name.isNullOrEmpty()) null else name
+    }
+
+    private fun geminiOn(): Boolean =
+        prefs.getBoolean("gemini_voice_on", false) && !prefs.getString("api_key", "").isNullOrBlank()
+
+    fun play(lines: List<Line>) {
+        stopQuiet()
+        generation++
+        queue = lines
+        index = 0
+        isPlaying = true
+        warned = false
+        lastError = null
+        onChange()
+        if (geminiOn() && lines.any { it.speaker != Speaker.SKIP }) startGemini(generation) else step(generation)
+    }
+
+    /** Phone voice, line by line. Also the fallback when Gemini is unavailable. */
+    private fun step(gen: Int) {
+        if (gen != generation || !isPlaying) return
+        while (index < queue.size && queue[index].speaker == Speaker.SKIP) index++
+        if (index >= queue.size) {
+            isPlaying = false
+            onChange()
+            return
+        }
+        speakOnPhone(queue[index], gen)
+    }
+
+    private fun voiceFor(speaker: Speaker): String {
+        val mine = prefs.getString("voice_custom", "")?.trim().orEmpty()
+        if (mine.isNotEmpty() && (prefs.getBoolean("custom_all", false) || speaker == Speaker.CUSTOM)) return mine
+        return voiceName(speaker) ?: voiceName(Speaker.NARRATOR) ?: DEFAULT_VOICES.getValue("voice_narrator")
+    }
+
+    private fun labelFor(speaker: Speaker): String = when (speaker) {
+        Speaker.GIRL -> "Girl"
+        Speaker.BOY -> "Boy"
+        Speaker.CUSTOM -> "Custom"
+        else -> "Narrator"
+    }
+
+    /** One request for the whole page: at most two voices (Gemini's limit), the most used ones. */
+    private fun buildPlan(lines: List<Line>): Pair<List<Pair<String, String>>, String> {
+        val active = lines.filter { it.speaker != Speaker.SKIP }
+        val counts = LinkedHashMap<String, Int>()
+        val labels = HashMap<String, String>()
+        for (line in active) {
+            val voice = voiceFor(line.speaker)
+            counts[voice] = (counts[voice] ?: 0) + 1
+            if (!labels.containsKey(voice)) labels[voice] = labelFor(line.speaker)
+        }
+        val keep = counts.entries.sortedByDescending { it.value }.take(1).map { it.key }
+        val voices = keep.map { (labels[it] ?: "Narrator") to it }
+        val text = StringBuilder()
+        if (keep.size >= 2) {
+            text.append("Read this manga dialogue naturally, pausing briefly between lines:\n")
+            for (line in active) {
+                var voice = voiceFor(line.speaker)
+                if (voice !in keep) voice = keep.first()
+                text.append(labels[voice]).append(": ").append(line.text).append("\n")
+            }
+        } else {
+            text.append("Read this manga dialogue naturally, pausing briefly between lines:\n")
+            for (line in active) text.append(line.text).append("\n")
+        }
+        return voices to text.toString().trim()
+    }
+
+    private fun startGemini(gen: Int) {
+        val (voices, text) = buildPlan(queue)
+        VoiceLog.add("voice: ${voices.joinToString { it.first + "=" + it.second }}, ${text.length} chars")
+        val apiKey = prefs.getString("api_key", "")?.trim().orEmpty()
+        val model = prefs.getString("tts_model", GeminiClient.DEFAULT_TTS_MODEL)?.trim().orEmpty()
+            .ifEmpty { GeminiClient.DEFAULT_TTS_MODEL }
+
+        net.execute {
+            fun alive() = gen == generation && isPlaying
+            val pop = GapPop()
+            val preroll = ByteArrayOutputStream()
+            var audio: AudioTrack? = null
+            var frames = 0L
+            var received = 0
+            var held: ByteArray? = null
+
+            fun write(bytes: ByteArray): Boolean {
+                val t = audio ?: return false
+                var offset = 0
+                while (offset < bytes.size) {
+                    if (!alive()) return false
+                    val n = try {
+                        t.write(bytes, offset, bytes.size - offset)
+                    } catch (e: Throwable) {
+                        -1
+                    }
+                    if (n <= 0) return false
+                    offset += n
+                }
+                frames += bytes.size / 2
+                return true
+            }
+
+            fun startTrack(): Boolean {
+                if (audio != null) return true
+                val min = AudioTrack.getMinBufferSize(
+                    GeminiClient.SAMPLE_RATE,
+                    AudioFormat.CHANNEL_OUT_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT,
+                )
+                val created = AudioTrack.Builder()
+                    .setAudioAttributes(
+                        AudioAttributes.Builder()
+                            .setUsage(AudioAttributes.USAGE_MEDIA)
+                            .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                            .build(),
+                    )
+                    .setAudioFormat(
+                        AudioFormat.Builder()
+                            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                            .setSampleRate(GeminiClient.SAMPLE_RATE)
+                            .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                            .build(),
+                    )
+                    .setBufferSizeInBytes(maxOf(min * 4, 96000))
+                    .setTransferMode(AudioTrack.MODE_STREAM)
+                    .build()
+                audio = created
+                track = created
+                created.play()
+                return true
+            }
+
+            // Hold back the newest piece so the very end can be faded out (no click).
+            fun push(raw: ByteArray): Boolean {
+                val processed = pop.process(raw)
+                if (processed.isEmpty()) return true
+                val previous = held
+                held = processed
+                if (audio == null) {
+                    if (previous != null) preroll.write(previous)
+                    if (preroll.size() < 40000) return true
+                    startTrack()
+                    val ready = preroll.toByteArray()
+                    preroll.reset()
+                    return write(ready)
+                }
+                return previous == null || write(previous)
+            }
+
+            fun sink(raw: ByteArray): Boolean {
+                if (!alive()) return false
+                received += raw.size
+                return push(raw)
+            }
+
+            fun finish() {
+                val rest = pop.flush()
+                if (rest.isNotEmpty()) push(rest)
+                val last = held
+                held = null
+                if (last != null) preroll.write(fadeOut(last))
+                if (preroll.size() > 0) {
+                    startTrack()
+                    write(preroll.toByteArray())
+                }
+                val t = audio
+                if (t != null && alive()) {
+                    try {
+                        t.stop()
+                    } catch (e: Throwable) {
+                        // ignore
+                    }
+                    var waited = 0
+                    while (alive() && waited < 90_000) {
+                        val head = try {
+                            t.playbackHeadPosition.toLong() and 0xFFFFFFFFL
+                        } catch (e: Throwable) {
+                            frames
+                        }
+                        if (head >= frames) break
+                        Thread.sleep(40)
+                        waited += 40
+                    }
+                }
+                main.post {
+                    if (alive()) {
+                        releaseTrack()
+                        isPlaying = false
+                        onChange()
+                    }
+                }
+            }
+
+            fun giveUp(message: String?) {
+                main.post {
+                    if (alive()) {
+                        releaseTrack()
+                        if (!warned) {
+                            warned = true
+                            toast(activity, "Gemini voice unavailable (${message ?: "unknown"}). Using phone voice")
+                        }
+                        index = 0
+                        step(gen)
+                    }
+                }
+            }
+
+            try {
+                val cloned = voices.first().second.let { it.startsWith("voice_") || it.startsWith("voicekey_") }
+                try {
+                    if (cloned) {
+                        val cloneModel = if (model.contains("lite")) GeminiClient.DEFAULT_TTS_MODEL else model
+                        sink(GeminiClient.synthesizeCustom(apiKey, cloneModel, voices.first().second, text))
+                    } else {
+                        GeminiClient.synthesizeStream(apiKey, model, voices, text) { sink(it) }
+                    }
+                } catch (e: GeminiException) {
+                    val hard = e.code == 401 || e.code == 403
+                    val retryable = e.code == 404 || e.code == 503 || e.code == 429
+                    if (cloned) {
+                        throw e
+                    } else if (received == 0 && retryable) {
+                        val alt = GeminiClient.pickModel(apiKey, true, model) ?: throw e
+                        if (e.code == 404) prefs.edit().putString("tts_model", alt).apply()
+                        VoiceLog.add("voice: $model failed (${e.code}), trying $alt")
+                        main.post { toast(activity, "$model is busy or missing. Trying $alt") }
+                        GeminiClient.synthesizeStream(apiKey, alt, voices, text) { sink(it) }
+                    } else if (received == 0 && !hard) {
+                        sink(GeminiClient.synthesize(apiKey, model, voices, text))
+                    } else {
+                        throw e
+                    }
+                }
+                if (received == 0) throw GeminiException("Gemini sent no audio")
+                finish()
+            } catch (e: Exception) {
+                VoiceLog.add("voice failed: ${e.javaClass.simpleName}: ${e.message}")
+                if (received == 0) {
+                    giveUp(e.message)
+                } else {
+                    finish()
+                }
+            }
+        }
+    }
+
+    /** A short fade so the clip never ends with a click or beep. */
+    private fun fadeOut(pcm: ByteArray): ByteArray {
+        val samples = pcm.size / 2
+        val n = minOf(samples, GeminiClient.SAMPLE_RATE * 40 / 1000)
+        for (k in 0 until n) {
+            val i = (samples - n + k) * 2
+            val v = (pcm[i].toInt() and 0xFF) or (pcm[i + 1].toInt() shl 8)
+            val scaled = (v * (1f - (k + 1f) / n)).toInt()
+            pcm[i] = (scaled and 0xFF).toByte()
+            pcm[i + 1] = ((scaled shr 8) and 0xFF).toByte()
+        }
+        return pcm
+    }
+
+    fun phoneVoiceNames(): List<String> = phoneVoices.map { it.name }
+
+    private fun applyPhoneVoice(engine: TextToSpeech, speaker: Speaker, overrideName: String?) {
+        val prefKey = when (speaker) {
+            Speaker.GIRL -> "phone_girl"
+            Speaker.BOY -> "phone_boy"
+            else -> null
+        }
+        val wanted = overrideName ?: prefKey?.let { prefs.getString(it, "") }.orEmpty()
+        val chosen = phoneVoices.firstOrNull { wanted.isNotEmpty() && it.name == wanted }
+        val voice = chosen ?: when (speaker) {
+            Speaker.GIRL -> girlVoice
+            Speaker.BOY -> boyVoice
+            else -> null
+        }
+        if (voice != null) {
+            engine.setVoice(voice)
+            engine.setPitch(1.0f)
+        } else {
+            defaultVoice?.let { engine.setVoice(it) }
+            engine.setPitch(speaker.pitch)
+        }
+    }
+
+    /** Plays a short sample so a phone voice can be judged while choosing it in settings. */
+    fun previewPhone(speaker: Speaker, name: String) {
+        stopQuiet()
+        val engine = tts
+        if (!ttsReady || engine == null) return
+        applyPhoneVoice(engine, speaker, name)
+        engine.setSpeechRate(prefs.getFloat("speed", 1.0f))
+        utteranceId = "preview"
+        engine.speak("Hello, this is how I sound.", TextToSpeech.QUEUE_FLUSH, null, "preview")
+    }
+
+    /** A soft bubble pop between lines (phone voice mode). */
+    private fun playPop() {
+        try {
+            val t = AudioTrack.Builder()
+                .setAudioAttributes(
+                    AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                        .build(),
+                )
+                .setAudioFormat(
+                    AudioFormat.Builder()
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                        .setSampleRate(GeminiClient.SAMPLE_RATE)
+                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                        .build(),
+                )
+                .setBufferSizeInBytes(POP.size)
+                .setTransferMode(AudioTrack.MODE_STATIC)
+                .build()
+            t.write(POP, 0, POP.size)
+            t.play()
+            main.postDelayed(
+                {
+                    try {
+                        t.release()
+                    } catch (e: Throwable) {
+                        // ignore
+                    }
+                },
+                500,
+            )
+        } catch (e: Throwable) {
+            // no pop, no problem
+        }
+    }
+
+    private fun speakOnPhone(line: Line, gen: Int) {
+        if (gen != generation || !isPlaying) return
+        if (ttsFailed) {
+            toast(activity, "Text-to-speech is not available on this phone")
+            stop()
+            return
+        }
+        val engine = tts
+        if (!ttsReady || engine == null) {
+            main.postDelayed({ speakOnPhone(line, gen) }, 300)
+            return
+        }
+        val speaker = line.speaker
+        applyPhoneVoice(engine, speaker, null)
+        engine.setSpeechRate(speaker.rate * prefs.getFloat("speed", 1.0f))
+        utteranceId = "g$gen-$index"
+        engine.speak(line.text, TextToSpeech.QUEUE_FLUSH, null, utteranceId)
+    }
+
+    private fun releaseTrack() {
+        try {
+            track?.stop()
+        } catch (e: Throwable) {
+            // already stopped
+        }
+        try {
+            track?.release()
+        } catch (e: Throwable) {
+            // already released
+        }
+        track = null
+    }
+
+    private fun stopQuiet() {
+        isPlaying = false
+        generation++
+        try {
+            tts?.stop()
+        } catch (e: Throwable) {
+            // ignore
+        }
+        releaseTrack()
+    }
+
+    fun stop() {
+        stopQuiet()
+        onChange()
+    }
+
+    fun shutdown() {
+        stopQuiet()
+        tts?.shutdown()
+        tts = null
+        net.shutdownNow()
+    }
+}
