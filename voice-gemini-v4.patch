+package eu.kanade.tachiyomi.ui.reader.voice
+
+import android.content.Context
+import android.media.MediaCodec
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.net.Uri
+import java.io.ByteArrayOutputStream
+
+/** Turns any audio file the user picks into the 24 kHz mono 16-bit WAV that Google asks for. */
+internal object VoiceClone {
+    private const val RATE = 24000
+
+    fun toWav(context: Context, uri: Uri, maxSeconds: Int, minSeconds: Int): ByteArray {
+        val extractor = MediaExtractor()
+        try {
+            extractor.setDataSource(context, uri, null)
+            var track = -1
+            var format: MediaFormat? = null
+            for (i in 0 until extractor.trackCount) {
+                val candidate = extractor.getTrackFormat(i)
+                if (candidate.getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true) {
+                    track = i
+                    format = candidate
+                    break
+                }
+            }
+            if (track < 0 || format == null) throw IllegalArgumentException("No sound found in that file")
+            extractor.selectTrack(track)
+            val mime = format.getString(MediaFormat.KEY_MIME) ?: throw IllegalArgumentException("Unknown audio type")
+            var rate = format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
+            var channels = format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+            val pcm = ByteArrayOutputStream()
+            val limit = (maxSeconds + 1).toLong() * rate * channels * 2
+
+            val codec = MediaCodec.createDecoderByType(mime)
+            try {
+                codec.configure(format, null, null, 0)
+                codec.start()
+                val info = MediaCodec.BufferInfo()
+                var inputDone = false
+                var outputDone = false
+                while (!outputDone && pcm.size() < limit) {
+                    if (!inputDone) {
+                        val index = codec.dequeueInputBuffer(10_000)
+                        if (index >= 0) {
+                            val buffer = codec.getInputBuffer(index)!!
+                            val size = extractor.readSampleData(buffer, 0)
+                            if (size < 0) {
+                                codec.queueInputBuffer(index, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+                                inputDone = true
+                            } else {
+                                codec.queueInputBuffer(index, 0, size, extractor.sampleTime, 0)
+                                extractor.advance()
+                            }
+                        }
+                    }
+                    val out = codec.dequeueOutputBuffer(info, 10_000)
+                    if (out >= 0) {
+                        val buffer = codec.getOutputBuffer(out)!!
+                        val bytes = ByteArray(info.size)
+                        buffer.position(info.offset)
+                        buffer.limit(info.offset + info.size)
+                        buffer.get(bytes)
+                        pcm.write(bytes)
+                        codec.releaseOutputBuffer(out, false)
+                        if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) outputDone = true
+                    } else if (out == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                        val changed = codec.outputFormat
+                        rate = changed.getInteger(MediaFormat.KEY_SAMPLE_RATE)
+                        channels = changed.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+                    }
+                }
+            } finally {
+                try {
+                    codec.stop()
+                } catch (e: Throwable) {
+                    // ignore
+                }
+                codec.release()
+            }
+
+            val data = pcm.toByteArray()
+            val frames = data.size / 2 / channels
+            if (frames <= 0) throw IllegalArgumentException("Could not read the sound in that file")
+            val mono = FloatArray(frames)
+            for (f in 0 until frames) {
+                var sum = 0f
+                for (c in 0 until channels) {
+                    val i = (f * channels + c) * 2
+                    sum += ((data[i].toInt() and 0xFF) or (data[i + 1].toInt() shl 8)).toFloat()
+                }
+                mono[f] = sum / channels
+            }
+            val outLength = minOf((frames.toLong() * RATE / rate).toInt(), RATE * maxSeconds)
+            if (outLength < RATE * minSeconds) {
+                throw IllegalArgumentException("That recording is too short (it needs at least $minSeconds seconds)")
+            }
+            val wav = ByteArrayOutputStream(44 + outLength * 2)
+            writeHeader(wav, outLength * 2)
+            for (i in 0 until outLength) {
+                val pos = i.toDouble() * rate / RATE
+                val i0 = minOf(pos.toInt(), frames - 1)
+                val i1 = minOf(i0 + 1, frames - 1)
+                val value = mono[i0] + (mono[i1] - mono[i0]) * (pos - i0).toFloat()
+                val sample = value.toInt().coerceIn(-32768, 32767)
+                wav.write(sample and 0xFF)
+                wav.write((sample shr 8) and 0xFF)
+            }
+            return wav.toByteArray()
+        } finally {
+            extractor.release()
+        }
+    }
+
+    private fun writeHeader(out: ByteArrayOutputStream, dataBytes: Int) {
+        fun int(v: Int) {
+            out.write(v and 0xFF)
+            out.write((v shr 8) and 0xFF)
+            out.write((v shr 16) and 0xFF)
+            out.write((v shr 24) and 0xFF)
+        }
+
+        fun short(v: Int) {
+            out.write(v and 0xFF)
+            out.write((v shr 8) and 0xFF)
+        }
+        out.write("RIFF".toByteArray())
+        int(36 + dataBytes)
+        out.write("WAVE".toByteArray())
+        out.write("fmt ".toByteArray())
+        int(16)
+        short(1)
+        short(1)
+        int(RATE)
+        int(RATE * 2)
+        short(2)
+        short(16)
+        out.write("data".toByteArray())
+        int(dataBytes)
+    }
+}
