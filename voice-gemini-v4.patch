+    val gap = dp(4)
+    for (b in listOf(copy, clear, close)) {
+        buttons.addView(
+            b,
+            LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply { setMargins(gap, 0, gap, 0) },
+        )
+    }
+
+    val title = TextView(activity).apply {
+        text = "Live log"
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+        typeface = Typeface.DEFAULT_BOLD
+    }
+    root.addView(title)
+    root.addView(
+        scroll,
+        LinearLayout.LayoutParams(
+            ViewGroup.LayoutParams.MATCH_PARENT,
+            (activity.resources.displayMetrics.heightPixels * 0.55f).toInt(),
+        ).apply { setMargins(0, dp(8), 0, dp(8)) },
+    )
+    root.addView(buttons)
+
+    val ticker = object : Runnable {
+        override fun run() {
+            refresh()
+            handler.postDelayed(this, 1000)
+        }
+    }
+    dialog.setOnDismissListener { handler.removeCallbacks(ticker) }
+    dialog.show()
+    ticker.run()
+}
