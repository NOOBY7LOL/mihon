+package eu.kanade.tachiyomi.ui.reader.voice
+
+import android.util.Base64
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+
+/** An error from Google's servers, with a message that can be shown to the reader. */
+internal class GeminiException(message: String, val code: Int = 0) : Exception(message)
+
+/**
+ * Minimal client for the Gemini REST API (no extra libraries).
+ * - [analyzePage] sends a manga page and gets back each line of text with who says it.
+ * - [synthesize] turns text into speech with one of Gemini's voices (raw 24 kHz 16-bit mono PCM).
+ */
+internal object GeminiClient {
+
+    const val DEFAULT_MODEL = "gemini-3.8-flash"
+    const val DEFAULT_TTS_MODEL = "gemini-3.8-flash-tts"
+    const val SAMPLE_RATE = 24000
+
+    private const val BASE = "https://generativelanguage.googleapis.com/v1beta/models/"
+
+    fun analyzePage(
+        apiKey: String,
+        model: String,
+        jpeg: ByteArray,
+        cast: String,
+        context: String,
+    ): List<Pair<String, String>> {
+        val prompt = buildPrompt(cast, context)
+        val image = JSONObject()
+            .put("mime_type", "image/jpeg")
+            .put("data", Base64.encodeToString(jpeg, Base64.NO_WRAP))
+        val parts = JSONArray()
+            .put(JSONObject().put("text", prompt))
+            .put(JSONObject().put("inline_data", image))
+        val content = JSONObject().put("role", "user").put("parts", parts)
+
+        fun body(lowThinking: Boolean): JSONObject {
+            val config = JSONObject().put("responseMimeType", "application/json")
+            if (lowThinking) config.put("thinkingConfig", JSONObject().put("thinkingLevel", "low"))
+            return JSONObject().put("contents", JSONArray().put(content)).put("generationConfig", config)
+        }
+
+        val url = "$BASE$model:generateContent"
+        val response = try {
+            post(url, apiKey, body(true), 120_000)
+        } catch (e: GeminiException) {
+            // Some models do not accept a thinking level; try once more without it.
+            if (e.code == 400) post(url, apiKey, body(false), 120_000) else throw e
+        }
+        return parseLines(response)
+    }
+
+    fun synthesize(apiKey: String, model: String, voiceName: String, text: String): ByteArray {
+        val voice = JSONObject().put("prebuiltVoiceConfig", JSONObject().put("voiceName", voiceName))
+        val config = JSONObject()
+            .put("responseModalities", JSONArray().put("AUDIO"))
+            .put("speechConfig", JSONObject().put("voiceConfig", voice))
+        val body = JSONObject()
+            .put(
+                "contents",
+                JSONArray().put(
+                    JSONObject().put("parts", JSONArray().put(JSONObject().put("text", text))),
+                ),
+            )
+            .put("generationConfig", config)
+
+        val response = post("$BASE$model:generateContent", apiKey, body, 60_000)
+        val parts = response.optJSONArray("candidates")
+            ?.optJSONObject(0)
+            ?.optJSONObject("content")
+            ?.optJSONArray("parts")
+        var data = ""
+        if (parts != null) {
+            for (i in 0 until parts.length()) {
+                val part = parts.optJSONObject(i) ?: continue
+                val inline = part.optJSONObject("inlineData") ?: part.optJSONObject("inline_data")
+                val candidate = inline?.optString("data", "") ?: ""
+                if (candidate.isNotEmpty()) {
+                    data = candidate
+                    break
+                }
+            }
+        }
+        if (data.isEmpty()) throw GeminiException("Gemini sent no audio")
+        return Base64.decode(data, Base64.DEFAULT)
+    }
+
+    private fun buildPrompt(cast: String, context: String): String {
+        val characters = cast.trim().ifEmpty { "not provided" }
+        val builder = StringBuilder()
+        builder.append("You are helping a text-to-speech reader for an English manga page. ")
+        builder.append("List every line of dialogue, thought and narration on this page in the correct reading order. ")
+        builder.append("Manga is read right to left and top to bottom unless the page is clearly laid out left to right. ")
+        builder.append("For each line give the text exactly as printed, but write it as a normal sentence, not in ALL CAPS, ")
+        builder.append("and say who speaks it: \"girl\" (a female character), \"boy\" (a male character), ")
+        builder.append("\"narrator\" (narration boxes and captions), or \"unsure\" if you cannot tell. ")
+        builder.append("Use these clues: which character the bubble tail points to, who is in the panel, ")
+        builder.append("names used when someone is addressed (the person addressed is usually not the speaker), ")
+        builder.append("and how the conversation alternates between characters. ")
+        builder.append("Skip sound effects and background signs unless they are spoken. ")
+        builder.append("Do not invent text that is not on the page.\n")
+        builder.append("Characters: ").append(characters).append("\n")
+        if (context.isNotBlank()) {
+            builder.append("The last lines from the previous page, for context only (do not repeat them):\n")
+            builder.append(context).append("\n")
+        }
+        builder.append("Reply with ONLY JSON in exactly this form: ")
+        builder.append("{\"lines\":[{\"text\":\"...\",\"speaker\":\"girl|boy|narrator|unsure\"}]}")
+        return builder.toString()
+    }
+
+    private fun parseLines(response: JSONObject): List<Pair<String, String>> {
+        val parts = response.optJSONArray("candidates")
+            ?.optJSONObject(0)
+            ?.optJSONObject("content")
+            ?.optJSONArray("parts")
+            ?: throw GeminiException("Gemini sent no answer for this page. Try again")
+
+        val raw = StringBuilder()
+        for (i in 0 until parts.length()) {
+            val part = parts.optJSONObject(i) ?: continue
+            if (!part.optBoolean("thought", false)) raw.append(part.optString("text", ""))
+        }
+        var text = raw.toString().trim()
+        if (text.startsWith("```")) {
+            text = text.removePrefix("```json").removePrefix("```").removeSuffix("```").trim()
+        }
+        val array = if (text.startsWith("[")) {
+            JSONArray(text)
+        } else {
+            JSONObject(text).optJSONArray("lines") ?: JSONArray()
+        }
+
+        val lines = ArrayList<Pair<String, String>>()
+        for (i in 0 until array.length()) {
+            val item = array.optJSONObject(i) ?: continue
+            val lineText = item.optString("text", "").trim()
+            if (lineText.isNotEmpty()) {
+                lines.add(lineText to item.optString("speaker", "unsure").trim().lowercase())
+            }
+        }
+        return lines
+    }
+
+    private fun post(url: String, apiKey: String, body: JSONObject, readTimeoutMs: Int): JSONObject {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.requestMethod = "POST"
+            connection.connectTimeout = 20_000
+            connection.readTimeout = readTimeoutMs
+            connection.doOutput = true
+            connection.setRequestProperty("Content-Type", "application/json")
+            connection.setRequestProperty("x-goog-api-key", apiKey)
+            connection.outputStream.use { it.write(body.toString().toByteArray(Charsets.UTF_8)) }
+
+            val code = connection.responseCode
+            val stream = if (code in 200..299) connection.inputStream else connection.errorStream
+            val text = stream?.bufferedReader()?.use { it.readText() } ?: ""
+            if (code !in 200..299) throw GeminiException(friendly(text, code), code)
+            return JSONObject(text)
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun friendly(text: String, code: Int): String {
+        val detail = try {
+            JSONObject(text).optJSONObject("error")?.optString("message")
+        } catch (e: Exception) {
+            null
+        }
+        return when (code) {
+            429 -> "Free limit reached for now. Try again later"
+            401, 403 -> "Google rejected the key. Check it in settings"
+            404 -> "Model name not found. Check it in settings"
+            400 -> detail?.takeIf { it.isNotBlank() } ?: "Google could not accept the request"
+            else -> "Google error $code" + (detail?.takeIf { it.isNotBlank() }?.let { " ($it)" } ?: "")
+        }
+    }
+}
