+/** Speaks lines one after another with Gemini voices (online) or the phone's own voice. */
+private class LinePlayer(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val onChange: () -> Unit,
+) {
+    private val main = Handler(Looper.getMainLooper())
+    private val net = Executors.newFixedThreadPool(3)
+    private val prefetch = HashMap<Int, CompletableFuture<ByteArray?>>()
+
+    private var tts: TextToSpeech? = null
+    private var ttsReady = false
+    private var ttsFailed = false
+    private var girlVoice: Voice? = null
+    private var boyVoice: Voice? = null
+    private var defaultVoice: Voice? = null
+
+    private var queue: List<Line> = emptyList()
+    private var index = 0
+    private var generation = 0
+    private var track: AudioTrack? = null
+    private var utteranceId = ""
+    private var warned = false
+
+    @Volatile
+    private var lastError: String? = null
+
+    var isPlaying = false
+        private set
+
+    init {
+        tts = TextToSpeech(activity.applicationContext) { status ->
+            if (status == TextToSpeech.SUCCESS) {
+                val engine = tts
+                engine?.setLanguage(Locale.US)
+                pickPhoneVoices(engine)
+                engine?.setOnUtteranceProgressListener(
+                    object : UtteranceProgressListener() {
+                        override fun onStart(id: String?) {}
+
+                        override fun onDone(id: String?) {
+                            main.post {
+                                if (id == utteranceId && isPlaying) {
+                                    index++
+                                    step(generation)
+                                }
+                            }
+                        }
+
+                        @Deprecated("Deprecated in Java")
+                        override fun onError(id: String?) {
+                            main.post { if (id == utteranceId) stop() }
+                        }
+                    },
+                )
+                ttsReady = true
+            } else {
+                ttsFailed = true
+            }
+        }
+    }
+
+    private fun pickPhoneVoices(engine: TextToSpeech?) {
+        try {
+            defaultVoice = engine?.defaultVoice
+            val english = (engine?.voices ?: emptySet()).filter {
+                it.locale.language == "en" && !it.isNetworkConnectionRequired
+            }
+            girlVoice = english.firstOrNull { it.name.contains("female", ignoreCase = true) }
+            boyVoice = english.firstOrNull {
+                it.name.contains("male", ignoreCase = true) && !it.name.contains("female", ignoreCase = true)
+            }
+        } catch (e: Throwable) {
+            // Fall back to pitch changes only.
+        }
+    }
+
+    private fun voiceName(speaker: Speaker): String? {
+        if (!prefs.getBoolean("gemini_voices", true)) return null
+        if (prefs.getString("api_key", "").isNullOrBlank()) return null
+        val key = when (speaker) {
+            Speaker.GIRL -> "voice_girl"
+            Speaker.BOY -> "voice_boy"
+            Speaker.CUSTOM -> "voice_custom"
+            else -> "voice_narrator"
+        }
+        val name = prefs.getString(key, DEFAULT_VOICES[key])?.trim()
+        return if (name.isNullOrEmpty()) null else name
+    }
+
+    fun play(lines: List<Line>) {
+        stopQuiet()
+        generation++
+        queue = lines
+        index = 0
+        isPlaying = true
+        warned = false
+        lastError = null
+        onChange()
+        step(generation)
+    }
+
+    private fun step(gen: Int) {
+        if (gen != generation || !isPlaying) return
+        while (index < queue.size && queue[index].speaker == Speaker.SKIP) index++
+        if (index >= queue.size) {
+            isPlaying = false
+            onChange()
+            return
+        }
+        val i = index
+        val line = queue[i]
+        val voice = voiceName(line.speaker)
+        if (voice == null) {
+            speakOnPhone(line, gen)
+            return
+        }
+        val future = prefetch.remove(i) ?: synthesize(voice, line.text)
+        prefetchNext(i + 1)
+        future.whenComplete { pcm, _ ->
+            main.post {
+                if (gen == generation && isPlaying) {
+                    if (pcm != null) {
+                        playPcm(pcm, line, gen)
+                    } else {
+                        if (!warned) {
+                            warned = true
+                            toast(activity, "Gemini voice unavailable (${lastError ?: "unknown"}). Using phone voice")
+                        }
+                        speakOnPhone(line, gen)
+                    }
+                }
+            }
+        }
+    }
+
+    private fun prefetchNext(from: Int) {
+        var j = from
+        while (j < queue.size && queue[j].speaker == Speaker.SKIP) j++
+        if (j >= queue.size || prefetch.containsKey(j)) return
+        val voice = voiceName(queue[j].speaker) ?: return
+        prefetch[j] = synthesize(voice, queue[j].text)
+    }
+
+    private fun synthesize(voice: String, text: String): CompletableFuture<ByteArray?> {
+        val apiKey = prefs.getString("api_key", "")?.trim().orEmpty()
+        val model = prefs.getString("tts_model", GeminiClient.DEFAULT_TTS_MODEL)?.trim().orEmpty()
+            .ifEmpty { GeminiClient.DEFAULT_TTS_MODEL }
+        return CompletableFuture.supplyAsync(
+            Supplier<ByteArray?> {
+                try {
+                    GeminiClient.synthesize(apiKey, model, voice, text)
+                } catch (e: Exception) {
+                    lastError = e.message
+                    null
+                }
+            },
+            net,
+        )
+    }
+
+    private fun playPcm(pcm: ByteArray, line: Line, gen: Int) {
+        val size = pcm.size - pcm.size % 2
+        if (size <= 0) {
+            speakOnPhone(line, gen)
+            return
+        }
+        try {
+            releaseTrack()
+            val audioTrack = AudioTrack.Builder()
+                .setAudioAttributes(
+                    AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                        .build(),
+                )
+                .setAudioFormat(
+                    AudioFormat.Builder()
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                        .setSampleRate(GeminiClient.SAMPLE_RATE)
+                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                        .build(),
+                )
+                .setBufferSizeInBytes(size)
+                .setTransferMode(AudioTrack.MODE_STATIC)
+                .build()
+            track = audioTrack
+            audioTrack.write(pcm, 0, size)
+            audioTrack.setNotificationMarkerPosition(maxOf(1, size / 2 - 1))
+            audioTrack.setPlaybackPositionUpdateListener(
+                object : AudioTrack.OnPlaybackPositionUpdateListener {
+                    override fun onMarkerReached(t: AudioTrack?) {
+                        main.post {
+                            if (gen == generation && isPlaying) {
+                                releaseTrack()
+                                index++
+                                step(gen)
+                            }
+                        }
+                    }
+
+                    override fun onPeriodicNotification(t: AudioTrack?) {}
+                },
+                main,
+            )
+            audioTrack.play()
+        } catch (e: Throwable) {
+            releaseTrack()
+            speakOnPhone(line, gen)
+        }
+    }
+
+    private fun speakOnPhone(line: Line, gen: Int) {
+        if (gen != generation || !isPlaying) return
+        if (ttsFailed) {
+            toast(activity, "Text-to-speech is not available on this phone")
+            stop()
+            return
+        }
+        val engine = tts
+        if (!ttsReady || engine == null) {
+            main.postDelayed({ speakOnPhone(line, gen) }, 300)
+            return
+        }
+        val speaker = line.speaker
+        val voice = when (speaker) {
+            Speaker.GIRL -> girlVoice
+            Speaker.BOY -> boyVoice
+            else -> null
+        }
+        if (voice != null) {
+            engine.setVoice(voice)
+            engine.setPitch(1.0f)
+        } else {
+            defaultVoice?.let { engine.setVoice(it) }
+            engine.setPitch(speaker.pitch)
+        }
+        engine.setSpeechRate(speaker.rate * prefs.getFloat("speed", 1.0f))
+        utteranceId = "g$gen-$index"
+        engine.speak(line.text, TextToSpeech.QUEUE_FLUSH, null, utteranceId)
+    }
+
+    private fun releaseTrack() {
+        try {
+            track?.stop()
+        } catch (e: Throwable) {
+            // already stopped
+        }
+        try {
+            track?.release()
+        } catch (e: Throwable) {
+            // already released
+        }
+        track = null
+    }
+
+    private fun stopQuiet() {
+        isPlaying = false
+        generation++
+        prefetch.clear()
+        try {
+            tts?.stop()
+        } catch (e: Throwable) {
+            // ignore
+        }
+        releaseTrack()
+    }
+
+    fun stop() {
+        stopQuiet()
+        onChange()
+    }
+
+    fun shutdown() {
+        stopQuiet()
+        tts?.shutdown()
+        tts = null
+        net.shutdownNow()
+    }
+}
