+import java.util.function.Supplier
+
+/** The page currently shown in the reader: a key for caching and a way to open the original image. */
+class VoicePage(val key: String, val stream: (() -> InputStream)?)
+
+/**
+ * Voice mode for the reader. Adds a small bar at the bottom of the screen:
+ * - Listen: sends the current page to Gemini, which returns each line of text and who says it
+ *   (girl, boy, narrator or unsure). Each line is then read in the matching voice.
+ *   Hold Listen to see the lines and fix who speaks any of them.
+ * - Stop: stops speaking (or cancels reading the page).
+ * - Settings: your free Google key, models, voices and a short cast description.
+ *
+ * Returns the bar so the reader can hide it while its own menus are showing.
+ */
+fun addVoiceListenButton(
+    activity: Activity,
+    root: ViewGroup,
+    source: View,
+    currentPage: () -> VoicePage?,
+): View {
+    return VoiceUi(activity, root, source, currentPage).install()
+}
+
+private enum class Speaker(
+    val label: String,
+    val emoji: String,
+    val color: Int,
+    val pitch: Float,
+    val rate: Float,
+) {
+    GIRL("Girl", "👧", 0xFFE91E8C.toInt(), 1.25f, 1.0f),
+    BOY("Boy", "👦", 0xFF1E88E5.toInt(), 0.8f, 1.0f),
+    NARRATOR("Narrator", "🎙", 0xFF43A047.toInt(), 1.0f, 0.95f),
+    CUSTOM("Custom", "⭐", 0xFFFB8C00.toInt(), 0.9f, 1.05f),
+    SKIP("Skip", "⏭", 0xFF757575.toInt(), 1.0f, 1.0f),
+    UNSURE("?", "❓", 0xFFFFC107.toInt(), 1.0f, 0.95f),
+    ;
+
+    fun next(): Speaker = when (this) {
+        UNSURE -> GIRL
+        GIRL -> BOY
+        BOY -> NARRATOR
+        NARRATOR -> CUSTOM
+        CUSTOM -> SKIP
+        SKIP -> GIRL
+    }
+}
+
+private class Line(val text: String, var speaker: Speaker)
+
+private val SPEED_LABELS = listOf("Slow" to 0.8f, "Normal" to 1.0f, "Fast" to 1.25f, "Faster" to 1.5f)
+
+private val DEFAULT_VOICES = mapOf(
+    "voice_girl" to "Kore",
+    "voice_boy" to "Puck",
+    "voice_narrator" to "Charon",
+    "voice_custom" to "",
+)
+
+private fun toast(activity: Activity, message: String) {
+    Toast.makeText(activity, message, Toast.LENGTH_LONG).show()
+}
+
+private fun speakerFromWord(word: String): Speaker = when (word) {
+    "girl", "female", "woman" -> Speaker.GIRL
+    "boy", "male", "man" -> Speaker.BOY
+    "narrator", "narration", "caption" -> Speaker.NARRATOR
+    else -> Speaker.UNSURE
+}
+
+private fun roundedBackground(fill: Int, radiusPx: Int, strokeColor: Int = 0, strokePx: Int = 0): GradientDrawable {
+    return GradientDrawable().apply {
+        cornerRadius = radiusPx.toFloat()
+        setColor(fill)
+        if (strokePx > 0) setStroke(strokePx, strokeColor)
+    }
+}
+
+/** Opens the original page image and returns it as a JPEG (at most ~2600 px). Null for very tall strips. */
+private fun decodeOriginal(provider: () -> InputStream): ByteArray? {
+    val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+    provider().use { BitmapFactory.decodeStream(it, null, bounds) }
+    val w = bounds.outWidth
+    val h = bounds.outHeight
+    if (w <= 0 || h <= 0 || h > 2.5f * w) return null
+    var sample = 1
+    while (maxOf(w, h) / sample > 2600) sample *= 2
+    val options = BitmapFactory.Options().apply { inSampleSize = sample }
+    val bitmap = provider().use { BitmapFactory.decodeStream(it, null, options) } ?: return null
+    val out = ByteArrayOutputStream()
+    bitmap.compress(Bitmap.CompressFormat.JPEG, 88, out)
+    bitmap.recycle()
+    return out.toByteArray()
+}
+
+private class VoiceUi(
+    private val activity: Activity,
+    private val root: ViewGroup,
+    private val source: View,
+    private val currentPage: () -> VoicePage?,
+) {
+    private val density = activity.resources.displayMetrics.density
+    private val prefs: SharedPreferences = activity.getSharedPreferences("voice_listen", Context.MODE_PRIVATE)
+    private val main = Handler(Looper.getMainLooper())
+    private val io = Executors.newSingleThreadExecutor()
+    private val player = LinePlayer(activity, prefs) { updateBar() }
+    private val cache = object : LinkedHashMap<String, List<Line>>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, List<Line>>?): Boolean = size > 40
+    }
+
+    private var lastLines: List<Line> = emptyList()
+    private var busy = false
+    private var requestId = 0
+
+    private lateinit var bar: LinearLayout
+    private lateinit var listenButton: TextView
+    private lateinit var stopButton: TextView
+
+    private fun dp(value: Int) = (value * density).toInt()
+
+    private fun pill(label: String, color: Int): TextView = TextView(activity).apply {
+        text = label
+        gravity = Gravity.CENTER
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 17f)
+        typeface = Typeface.DEFAULT_BOLD
+        setPadding(dp(18), dp(10), dp(18), dp(10))
+        background = roundedBackground(color, dp(30))
+    }
+
+    fun install(): View {
+        bar = LinearLayout(activity).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dp(6), dp(6), dp(6), dp(6))
+            background = roundedBackground(0xE6202124.toInt(), dp(40), 0x55FFFFFF, dp(1))
+            elevation = dp(8).toFloat()
+        }
+        listenButton = pill("🔊 Listen", 0xFF3949AB.toInt()).apply {
+            setOnClickListener { onListenTap() }
+            setOnLongClickListener {
+                read(openEditor = true)
+                true
+            }
+        }
+        stopButton = pill("■ Stop", 0xFFD32F2F.toInt()).apply {
+            visibility = View.GONE
+            setOnClickListener { onStopTap() }
+        }
+        val settingsButton = pill("⚙", 0xFF424242.toInt()).apply {
+            setOnClickListener { showSettings(activity, prefs) }
+        }
+        val gap = dp(3)
+        for (button in listOf(listenButton, stopButton, settingsButton)) {
+            bar.addView(
+                button,
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                    .apply { setMargins(gap, 0, gap, 0) },
+            )
+        }
+        root.addView(
+            bar,
+            FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL,
+            ).apply { setMargins(0, 0, 0, dp(52)) },
+        )
+        root.addOnAttachStateChangeListener(
+            object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) {}
+
+                override fun onViewDetachedFromWindow(v: View) {
+                    requestId++
+                    main.removeCallbacksAndMessages(null)
+                    io.shutdownNow()
+                    player.shutdown()
+                }
+            },
+        )
+        return bar
+    }
+
+    private fun updateBar() {
+        listenButton.text = if (busy) "Reading page..." else "🔊 Listen"
+        stopButton.visibility = if (busy || player.isPlaying) View.VISIBLE else View.GONE
+    }
+
+    private fun onListenTap() {
+        if (player.isPlaying) {
+            player.stop()
+        } else if (!busy) {
+            read(openEditor = false)
+        }
+    }
+
+    private fun onStopTap() {
+        if (player.isPlaying) player.stop()
+        if (busy) {
+            requestId++
+            busy = false
+            updateBar()
+        }
+    }
+
+    // ---- reading a page ------------------------------------------------------------------
+
+    private fun read(openEditor: Boolean) {
+        if (busy) return
+        val apiKey = prefs.getString("api_key", "")?.trim().orEmpty()
+        if (apiKey.isEmpty()) {
+            toast(activity, "Paste your free Google key first")
+            showSettings(activity, prefs)
+            return
+        }
+        val page = currentPage()
+        val cached = page?.let { cache[it.key] }
+        if (cached != null) {
+            deliver(cached, openEditor)
+            return
+        }
+
+        busy = true
+        player.stop()
+        val token = ++requestId
+        updateBar()
+        capture(page) { jpeg ->
+            if (token != requestId) {
+                // cancelled
+            } else if (jpeg == null) {
+                fail("Could not capture the page")
+            } else {
+                val model = prefs.getString("model", GeminiClient.DEFAULT_MODEL)?.trim().orEmpty()
+                    .ifEmpty { GeminiClient.DEFAULT_MODEL }
+                val cast = prefs.getString("cast", "").orEmpty()
+                val context = lastLines.takeLast(6).joinToString("\n") { "${it.speaker.name.lowercase()}: ${it.text}" }
+                io.execute {
+                    try {
+                        val result = GeminiClient.analyzePage(apiKey, model, jpeg, cast, context)
+                        main.post { if (token == requestId) analyzed(result, page?.key, openEditor) }
+                    } catch (e: Exception) {
+                        val message = when (e) {
+                            is GeminiException -> e.message ?: "Gemini error"
+                            is IOException -> "Could not reach Google. Check your internet"
+                            else -> "Could not understand Gemini's answer. Try again"
+                        }
+                        main.post { if (token == requestId) fail(message) }
+                    }
+                }
+            }
+        }
+    }
+
+    private fun analyzed(result: List<Pair<String, String>>, key: String?, openEditor: Boolean) {
+        busy = false
+        val lines = result.map { Line(it.first, speakerFromWord(it.second)) }
+        if (lines.isNotEmpty()) {
+            lastLines = lines
+            if (key != null) cache[key] = lines
+        }
+        updateBar()
+        deliver(lines, openEditor)
+    }
+
+    private fun fail(message: String) {
+        busy = false
+        updateBar()
+        toast(activity, message)
+    }
+
+    private fun deliver(lines: List<Line>, openEditor: Boolean) {
+        if (activity.isFinishing || activity.isDestroyed) return
+        if (lines.isEmpty()) {
+            toast(activity, "No text found on this page")
+        } else if (openEditor) {
+            LinesDialog(activity, prefs, player, lines).show()
+        } else {
+            val unsure = lines.count { it.speaker == Speaker.UNSURE }
+            if (!prefs.getBoolean("tip_shown", false)) {
+                prefs.edit().putBoolean("tip_shown", true).apply()
+                toast(activity, "Tip: hold Listen to fix who speaks a line")
+            } else if (unsure > 0) {
+                toast(activity, "$unsure line(s) unsure. Hold Listen to fix them")
+            }
+            player.play(lines)
+        }
+    }
+
+    /** The page image as a JPEG: the original file when possible, otherwise a screenshot. */
+    private fun capture(page: VoicePage?, onResult: (ByteArray?) -> Unit) {
+        val provider = page?.stream
+        io.execute {
+            val original = if (provider != null) {
+                try {
+                    decodeOriginal(provider)
+                } catch (e: Throwable) {
+                    null
+                }
+            } else {
+                null
+            }
+            main.post {
+                if (original != null) onResult(original) else screenshot(onResult)
+            }
+        }
+    }
+
+    private fun screenshot(onResult: (ByteArray?) -> Unit) {
+        if (source.width <= 0 || source.height <= 0) {
+            onResult(null)
+            return
+        }
+        val location = IntArray(2)
+        source.getLocationInWindow(location)
+        val area = Rect(location[0], location[1], location[0] + source.width, location[1] + source.height)
+        val previous = bar.visibility
+        bar.visibility = View.INVISIBLE
+        main.postDelayed(
+            {
+                val bitmap = try {
+                    Bitmap.createBitmap(area.width(), area.height(), Bitmap.Config.ARGB_8888)
+                } catch (e: Throwable) {
+                    null
+                }
+                if (bitmap == null) {
+                    bar.visibility = previous
+                    onResult(null)
+                } else {
+                    try {
+                        PixelCopy.request(
+                            activity.window,
+                            area,
+                            bitmap,
+                            { result ->
+                                bar.visibility = previous
+                                if (result == PixelCopy.SUCCESS) {
+                                    val out = ByteArrayOutputStream()
+                                    bitmap.compress(Bitmap.CompressFormat.JPEG, 90, out)
+                                    onResult(out.toByteArray())
+                                } else {
+                                    onResult(null)
+                                }
+                            },
+                            main,
+                        )
+                    } catch (e: Throwable) {
+                        bar.visibility = previous
+                        onResult(null)
+                    }
+                }
+            },
+            120,
+        )
+    }
+}
