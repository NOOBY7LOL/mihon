+/** Editor opened by holding Listen: pick who speaks each line, speed and reading order. */
+private class VoiceDialog(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val player: VoicePlayer,
+    private val bubbles: List<Bubble>,
+) {
+
+    private val list = LinearLayout(activity).apply { orientation = LinearLayout.VERTICAL }
+    private val density = activity.resources.displayMetrics.density
+
+    private fun dp(value: Int) = (value * density).toInt()
+
+    private fun label(message: String, sp: Float, bold: Boolean = false) = TextView(activity).apply {
+        text = message
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        if (bold) typeface = Typeface.DEFAULT_BOLD
+    }
+
+    private fun button(message: String, onClick: (Button) -> Unit) = Button(activity).apply {
+        text = message
+        isAllCaps = false
+        setTextColor(Color.WHITE)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+        typeface = Typeface.DEFAULT_BOLD
+        minHeight = dp(44)
+        background = GradientDrawable().apply {
+            cornerRadius = dp(10).toFloat()
+            setColor(0xFF3949AB.toInt())
+        }
+        setOnClickListener { onClick(this) }
+    }
+
+    private fun speedLabel(): String {
+        val speed = prefs.getFloat("speed", 1.0f)
+        return "Speed: " + (SPEED_LABELS.firstOrNull { it.second == speed }?.first ?: "Normal")
+    }
+
+    private fun render() {
+        list.removeAllViews()
+        for (bubble in order(bubbles, prefs.getBoolean("rtl", true))) {
+            val row = LinearLayout(activity).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, dp(6), 0, dp(6))
+            }
+            val who = button(bubble.speaker.emoji + " " + bubble.speaker.label) { b ->
+                bubble.speaker = bubble.speaker.next()
+                b.text = bubble.speaker.emoji + " " + bubble.speaker.label
+            }
+            val line = label(bubble.text, 18f).apply {
+                maxLines = 4
+                ellipsize = TextUtils.TruncateAt.END
+                setPadding(dp(12), 0, 0, 0)
+                setOnClickListener { player.playOne(bubble) }
+            }
+            row.addView(who, LinearLayout.LayoutParams(dp(130), ViewGroup.LayoutParams.WRAP_CONTENT))
+            row.addView(line, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            list.addView(row)
+        }
+    }
+
+    fun show() {
+        val root = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(18), dp(16), dp(18), dp(12))
+        }
+        val dialog = AlertDialog.Builder(activity)
+            .setView(root)
+            .setOnDismissListener { player.stop() }
+            .create()
+        dialog.window?.setBackgroundDrawable(
+            GradientDrawable().apply {
+                cornerRadius = dp(16).toFloat()
+                setColor(0xFF202124.toInt())
+            },
+        )
+
+        val hint = label("Tap a name to change who speaks. Tap a line to hear just that one.", 15f).apply {
+            setTextColor(0xFFCCCCCC.toInt())
+        }
+        val speedButton = button(speedLabel()) { b ->
+            val speed = prefs.getFloat("speed", 1.0f)
+            val i = SPEED_LABELS.indexOfFirst { it.second == speed }
+            val next = SPEED_LABELS[(i + 1) % SPEED_LABELS.size]
+            prefs.edit().putFloat("speed", next.second).apply()
+            b.text = speedLabel()
+        }
+        val orderBox = CheckBox(activity).apply {
+            text = "Right-to-left order"
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+            isChecked = prefs.getBoolean("rtl", true)
+            setOnCheckedChangeListener { _, checked ->
+                prefs.edit().putBoolean("rtl", checked).apply()
+                render()
+            }
+        }
+        val scroll = ScrollView(activity).apply { addView(list) }
+
+        val buttons = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+        val play = button("Play all") { player.playAll(order(bubbles, prefs.getBoolean("rtl", true))) }
+        val stop = button("Stop") { player.stop() }
+        val close = button("Close") { dialog.dismiss() }
+        val gap = dp(4)
+        for (b in listOf(play, stop, close)) {
+            buttons.addView(
+                b,
+                LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply {
+                    setMargins(gap, 0, gap, 0)
+                },
+            )
+        }
+
+        root.addView(label("Listen", 24f, bold = true))
+        root.addView(hint)
+        root.addView(
+            speedButton,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                .apply { setMargins(0, dp(8), 0, dp(4)) },
+        )
+        root.addView(orderBox)
+        root.addView(
+            scroll,
+            LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                (activity.resources.displayMetrics.heightPixels * 0.42f).toInt(),
+            ),
+        )
+        root.addView(buttons)
+
+        render()
+        dialog.show()
+    }
+}
