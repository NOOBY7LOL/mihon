+}
+
+private fun circleBackground(fill: Int, stroke: Int, strokePx: Int): GradientDrawable {
+    return GradientDrawable().apply {
+        shape = GradientDrawable.OVAL
+        setColor(fill)
+        setStroke(strokePx, stroke)
+    }
+}
+
+/** Manga is often ALL CAPS, which text-to-speech may spell out. Make it normal sentence case. */
+private fun cleanText(raw: String): String {
+    var t = raw.replace("-\n", "").replace('\n', ' ').replace(Regex("\\s+"), " ").trim()
+    if (t.none { it.isLowerCase() }) {
+        t = t.lowercase(Locale.US).replace(Regex("\\bi\\b"), "I").replaceFirstChar { it.uppercase() }
+    }
+    return t
+}
+
+private fun toBubble(block: Text.TextBlock, speaker: Speaker): Bubble? {
+    val box = block.boundingBox ?: return null
+    val text = cleanText(block.text)
+    if (text.count { it.isLetter() } < 2) return null
+    return Bubble(text, Rect(box), speaker)
+}
+
+/** Rough reading order: rows from top to bottom, then left/right inside each row. */
+private fun order(bubbles: List<Bubble>, rightToLeft: Boolean): List<Bubble> {
+    val rows = mutableListOf<MutableList<Bubble>>()
+    for (bubble in bubbles.sortedBy { it.box.centerY() }) {
+        val row = rows.lastOrNull()
+        if (row != null && abs(bubble.box.centerY() - row[0].box.centerY()) < row[0].box.height()) {
+            row.add(bubble)
+        } else {
+            rows.add(mutableListOf(bubble))
+        }
+    }
+    return rows.flatMap { row ->
+        if (rightToLeft) row.sortedByDescending { it.box.centerX() } else row.sortedBy { it.box.centerX() }
+    }
+}
+
+/** Enlarge a screenshot (at least ~1440 px wide, up to 4x) and add a white border to help OCR. */
+private fun prepareForOcr(src: Bitmap): Bitmap {
+    return try {
+        val longest = maxOf(src.width, src.height).toFloat()
+        var scale = (1440f / src.width).coerceIn(1f, 4f)
+        if (longest * scale > 3500f) scale = maxOf(1f, 3500f / longest)
+        val w = (src.width * scale).toInt()
+        val h = (src.height * scale).toInt()
+        val pad = 32
+        val out = Bitmap.createBitmap(w + 2 * pad, h + 2 * pad, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(out)
+        canvas.drawColor(Color.WHITE)
+        val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+        canvas.drawBitmap(src, null, Rect(pad, pad, pad + w, pad + h), paint)
+        src.recycle()
+        out
+    } catch (e: Throwable) {
+        src
+    }
+}
