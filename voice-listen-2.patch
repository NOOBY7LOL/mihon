+/**
+ * Voice mode for the reader.
+ *
+ * - Voice marker (right side): tap it to open the voice menu, or hold it and slide to a voice.
+ *   After a voice is chosen, draw a circle around a speech bubble and it is read aloud at once
+ *   in that voice.
+ * - Stop button (below the marker): stops speaking, or leaves circle mode when nothing is playing.
+ * - Listen button: tap to read the whole visible page in the current voice, hold to edit lines.
+ *
+ * Text is found with on-device OCR (ML Kit, English/Latin) on a real screenshot of the area,
+ * enlarged for small lettering, and read with the phone's text-to-speech.
+ */
+fun addVoiceListenButton(activity: Activity, root: ViewGroup, source: View) {
+    VoiceUi(activity, root, source).install()
+}
