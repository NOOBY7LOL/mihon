+
+    private fun markerParams(sizeDp: Int) =
+        FrameLayout.LayoutParams(dp(sizeDp), dp(sizeDp), Gravity.END or Gravity.CENTER_VERTICAL)
+            .apply { setMargins(0, 0, dp(14), 0) }
+
+    // ---- marker, menu, modes -------------------------------------------------------------
+
+    private fun onMarkerTouch(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                holding = false
+                main.postDelayed(longPress, 280)
+            }
+            MotionEvent.ACTION_MOVE -> if (holding) highlight(hitOption(event.rawX, event.rawY))
+            MotionEvent.ACTION_UP -> {
+                main.removeCallbacks(longPress)
+                if (holding) {
+                    val hit = hitOption(event.rawX, event.rawY)
+                    holding = false
+                    highlight(-1)
+                    if (hit >= 0) choose(VOICES[hit]) else closeMenu()
+                } else if (menuOpen) {
+                    closeMenu()
+                } else {
+                    openMenu()
+                }
+            }
+            MotionEvent.ACTION_CANCEL -> {
+                main.removeCallbacks(longPress)
+                holding = false
+                highlight(-1)
+            }
+        }
+        return true
+    }
+
+    private fun hitOption(rawX: Float, rawY: Float): Int {
+        var best = -1
+        var bestDistance = dp(40).toFloat()
+        val location = IntArray(2)
+        optionViews.forEachIndexed { index, view ->
+            if (view.visibility == View.VISIBLE) {
+                view.getLocationOnScreen(location)
+                val distance = hypot(rawX - (location[0] + view.width / 2f), rawY - (location[1] + view.height / 2f))
+                if (distance < bestDistance) {
+                    bestDistance = distance
+                    best = index
+                }
+            }
+        }
+        return best
+    }
+
+    private fun highlight(index: Int) {
+        optionViews.forEachIndexed { i, view ->
+            val scale = if (i == index) 1.3f else 1f
+            view.animate().scaleX(scale).scaleY(scale).setDuration(90).start()
+        }
+    }
+
+    private fun openMenu() {
+        if (menuOpen) return
+        menuOpen = true
+        VOICES.indices.forEach { i ->
+            val view = optionViews[i]
+            val angle = Math.toRadians(-67.5 + 45.0 * i)
+            val radius = dp(120)
+            view.visibility = View.VISIBLE
+            view.alpha = 0f
+            view.scaleX = 0.3f
+            view.scaleY = 0.3f
+            view.translationX = 0f
+            view.translationY = markerShiftY
+            view.animate()
+                .translationX((-radius * cos(angle)).toFloat())
+                .translationY(markerShiftY + (radius * sin(angle)).toFloat())
+                .alpha(1f)
+                .scaleX(1f)
+                .scaleY(1f)
+                .setStartDelay(i * 25L)
+                .setDuration(230)
+                .setInterpolator(OvershootInterpolator())
+                .start()
+        }
+    }
+
+    private fun closeMenu() {
+        if (!menuOpen) return
+        menuOpen = false
+        optionViews.forEach { view ->
+            view.animate()
+                .translationX(0f)
+                .translationY(markerShiftY)
+                .alpha(0f)
+                .scaleX(0.3f)
+                .scaleY(0.3f)
+                .setStartDelay(0)
+                .setDuration(150)
+                .setInterpolator(null)
+                .withEndAction { if (!menuOpen) view.visibility = View.GONE }
+                .start()
+        }
+    }
+
+    private fun choose(speaker: Speaker) {
+        voice = speaker
+        prefs.edit().putString("voice", speaker.name).apply()
+        closeMenu()
+        drawMode = true
+        overlay.visibility = View.VISIBLE
+        refreshMarker()
+        updateStop()
+        val note = if (speaker == Speaker.CUSTOM) " (uploaded voices are not ready yet, using a spare AI voice)" else ""
+        toast(activity, "${speaker.label} voice: circle a speech bubble$note")
+    }
+
+    private fun exitDrawMode() {
+        drawMode = false
+        overlay.clear()
+        overlay.visibility = View.GONE
+        refreshMarker()
+        updateStop()
+        toast(activity, "Circle mode off. Pick a voice to start again")
+    }
+
+    private fun refreshMarker() {
+        marker.text = voice.emoji
+        marker.background = circleBackground(0xF0202124.toInt(), voice.color, dp(4))
+        marker.alpha = if (drawMode) 1f else 0.8f
+        overlay.setStrokeColorValue(voice.color)
+    }
+
+    private fun updateStop() {
+        stopButton.visibility = if (drawMode || player.isPlaying) View.VISIBLE else View.GONE
+    }
+
+    // ---- reading -------------------------------------------------------------------------
+
+    private fun onCircle(rect: Rect) {
+        overlay.clear()
+        if (busy) return
+        val minSide = dp(40)
+        if (rect.width() < minSide || rect.height() < minSide) {
+            toast(activity, "Draw a bigger circle around the speech bubble")
+            return
+        }
+        val pad = (maxOf(rect.width(), rect.height()) * 0.08f).toInt() + dp(4)
+        val area = Rect(rect.left - pad, rect.top - pad, rect.right + pad, rect.bottom + pad)
+        area.intersect(0, 0, overlay.width, overlay.height)
+        val location = IntArray(2)
+        overlay.getLocationInWindow(location)
+        area.offset(location[0], location[1])
+        busy = true
+        read(area) { found ->
+            busy = false
+            if (found == null) {
+                toast(activity, "Could not read that. Try again")
+            } else if (found.isEmpty()) {
+                toast(activity, "No text found. Zoom in and circle again")
+            } else {
+                val rtl = prefs.getBoolean("rtl", true)
+                val text = order(found, rtl).joinToString(" ") { it.text }
+                player.playAll(listOf(Bubble(text, area, voice)))
+            }
+        }
+    }
+
+    private fun onListenTap() {
+        if (player.isPlaying) {
+            player.stop()
+        } else {
+            readPage(openEditor = false)
+        }
+    }
+
+    private fun readPage(openEditor: Boolean) {
+        if (busy) return
+        if (source.width <= 0 || source.height <= 0) {
+            toast(activity, "Page is not ready yet")
+            return
+        }
+        val location = IntArray(2)
+        source.getLocationInWindow(location)
+        val area = Rect(location[0], location[1], location[0] + source.width, location[1] + source.height)
+        busy = true
+        toast(activity, "Reading page...")
+        read(area) { found ->
+            busy = false
+            if (found == null) {
+                toast(activity, "Could not read this page")
+            } else if (found.isEmpty()) {
+                toast(activity, "No text found on this page")
+            } else if (!activity.isFinishing && !activity.isDestroyed) {
+                if (openEditor) {
+                    VoiceDialog(activity, prefs, player, found).show()
+                } else {
+                    val lines = order(found, prefs.getBoolean("rtl", true))
+                    toast(activity, "Reading ${lines.size} lines")
+                    player.playAll(lines)
+                }
+            }
+        }
+    }
+
+    /** Screenshot [area] (window coordinates), enlarge it, find the text. Result is null on failure. */
+    private fun read(area: Rect, onResult: (List<Bubble>?) -> Unit) {
+        val hidden = listOf(listenButton, marker, stopButton).filter { it.visibility == View.VISIBLE }
+        hidden.forEach { it.visibility = View.INVISIBLE }
+        val restore = { hidden.forEach { it.visibility = View.VISIBLE } }
+        main.postDelayed(
+            {
+                val shot = try {
+                    if (area.width() > 0 && area.height() > 0) {
+                        Bitmap.createBitmap(area.width(), area.height(), Bitmap.Config.ARGB_8888)
+                    } else {
+                        null
+                    }
+                } catch (e: Throwable) {
+                    null
+                }
+                if (shot == null) {
+                    restore()
+                    onResult(null)
+                } else {
+                    try {
+                        PixelCopy.request(
+                            activity.window,
+                            area,
+                            shot,
+                            { result ->
+                                restore()
+                                if (result == PixelCopy.SUCCESS) recognize(shot, onResult) else onResult(null)
+                            },
+                            main,
+                        )
+                    } catch (e: Throwable) {
+                        restore()
+                        onResult(null)
+                    }
+                }
+            },
+            120,
+        )
+    }
+
+    private fun recognize(shot: Bitmap, onResult: (List<Bubble>?) -> Unit) {
+        val prepared = prepareForOcr(shot)
+        val recognizer = TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS)
+        recognizer.process(InputImage.fromBitmap(prepared, 0))
+            .addOnSuccessListener { result ->
+                prepared.recycle()
+                recognizer.close()
+                onResult(result.textBlocks.mapNotNull { toBubble(it, voice) })
+            }
+            .addOnFailureListener {
+                prepared.recycle()
+                recognizer.close()
+                onResult(null)
+            }
+    }
+}
+
+private class VoicePlayer(
+    private val activity: Activity,
+    private val prefs: SharedPreferences,
+    private val onChange: () -> Unit,
+) {
+
+    private var tts: TextToSpeech? = null
+    private var ready = false
+    private val handler = Handler(Looper.getMainLooper())
+    private var queue: List<Bubble> = emptyList()
+    private var index = 0
+    private var playing = false
+    private var pending: List<Bubble>? = null
+    private var girlVoice: Voice? = null
+    private var boyVoice: Voice? = null
+    private var defaultVoice: Voice? = null
+
+    val isPlaying: Boolean get() = playing || pending != null
+
+    init {
+        tts = TextToSpeech(activity.applicationContext) { status ->
+            if (status == TextToSpeech.SUCCESS) {
+                val engine = tts
+                engine?.setLanguage(Locale.US)
+                pickVoices(engine)
+                engine?.setOnUtteranceProgressListener(
+                    object : UtteranceProgressListener() {
+                        override fun onStart(utteranceId: String?) {}
+
+                        override fun onDone(utteranceId: String?) {
+                            handler.post {
+                                index++
+                                speakCurrent()
+                            }
+                        }
+
+                        @Deprecated("Deprecated in Java")
+                        override fun onError(utteranceId: String?) {
+                            handler.post { stop() }
+                        }
+                    },
+                )
+                ready = true
+                pending?.let { waiting ->
+                    pending = null
+                    start(waiting)
+                }
+            } else {
+                toast(activity, "Text-to-speech is not available on this phone")
+            }
+        }
+    }
+
+    private fun pickVoices(engine: TextToSpeech?) {
+        try {
+            defaultVoice = engine?.defaultVoice
+            val english = (engine?.voices ?: emptySet()).filter {
+                it.locale.language == "en" && !it.isNetworkConnectionRequired
+            }
+            girlVoice = english.firstOrNull { it.name.contains("female", ignoreCase = true) }
+            boyVoice = english.firstOrNull {
+                it.name.contains("male", ignoreCase = true) && !it.name.contains("female", ignoreCase = true)
+            }
+        } catch (e: Throwable) {
+            // Fall back to pitch changes only.
+        }
+    }
+
+    fun playAll(bubbles: List<Bubble>) = play(bubbles)
+
+    fun playOne(bubble: Bubble) = play(listOf(bubble))
+
+    private fun play(bubbles: List<Bubble>) {
+        if (!ready) {
+            pending = bubbles
+            onChange()
+            toast(activity, "Voice is loading, it will start in a moment")
+            return
+        }
+        start(bubbles)
+    }
+
+    private fun start(bubbles: List<Bubble>) {
+        tts?.stop()
+        queue = bubbles
+        index = 0
+        playing = true
+        onChange()
+        speakCurrent()
+    }
+
+    private fun speakCurrent() {
+        if (!playing) return
+        val engine = tts ?: return
+        while (index < queue.size && queue[index].speaker == Speaker.SKIP) index++
+        val bubble = queue.getOrNull(index)
+        if (bubble == null) {
+            playing = false
+            onChange()
+            return
+        }
+        val speaker = bubble.speaker
+        val voice = when (speaker) {
+            Speaker.GIRL -> girlVoice
+            Speaker.BOY -> boyVoice
+            else -> null
+        }
+        if (voice != null) {
+            engine.setVoice(voice)
+            engine.setPitch(1.0f)
+        } else {
+            defaultVoice?.let { engine.setVoice(it) }
+            engine.setPitch(speaker.pitch)
+        }
+        engine.setSpeechRate(speaker.rate * prefs.getFloat("speed", 1.0f))
+        engine.speak(bubble.text, TextToSpeech.QUEUE_FLUSH, null, "bubble-$index")
+    }
+
+    fun stop() {
+        playing = false
+        pending = null
+        tts?.stop()
+        onChange()
+    }
+
+    fun shutdown() {
+        playing = false
+        pending = null
+        tts?.stop()
+        tts?.shutdown()
+        tts = null
+    }
+}
